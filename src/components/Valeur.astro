---
import '../styles/styleComponents/Valeur.css';
import '../styles/global.css';
---

<section class="reveal valeurSection">

    <div class="valeurContainer">
        <h2>Nos valeurs</h2>
        <div class="lignesValeurs">
            <div class="caseValeur reveal">
                <p class="numVal">01</p>
                <p class="val">PROXIMITÉ</p>
                <p class="descVal">Rester proches de nos clients, de nos équipes et de nos partenaires.</p>
            </div>

            <div class="caseValeur reveal">
                <p class="numVal">02</p>
                <p class="val">QUALITÉ</p>
                <p class="descVal">Rechercher un travail durable et réalisé dans les règles de l’art.</p>
            </div>

            <div class="caseValeur reveal">
                <p class="numVal">03</p>
                <p class="val">TRANSPARENCE</p>
                <p class="descVal">Une entreprise locale, ancrée dans l'Oise, à l'écoute de chaque projet.</p>
            </div>

            <div class="caseValeur reveal">
                <p class="numVal">04</p>
                <p class="val">ACCOMPAGNEMENT</p>
                <p class="descVal">Être présent de l’étude du projet jusqu’à sa réalisation.</p>
            </div>
        </div>
    </div>

</section>
