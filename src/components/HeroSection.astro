---
import { Check, Star } from '@lucide/astro';
import '../styles/styleComponents/HeroSection.css';
import '../styles/global.css';
import { getImage, Image } from 'astro:assets';
import heroImgSrc from '../assets/image/ImageHero.webp';
import FormHero from './FormHero.astro';
import logoRge from '../assets/image/logo-rge.webp';
import logoCertibat from '../assets/image/logoCertibat.webp';
import logoFfb from '../assets/image/Logo-fede-francaise-batiment.png';
import logoProeco from '../assets/image/logo_reseau-proeco-energies_green.svg';

// Une seule image generee (getImage), reutilisee pour les deux usages (fond
// CSS desktop + balise <img> mobile) : en utilisant <Image> ET un
// background-image url() separement sur la meme source, Astro finissait par
// n'ecrire qu'un seul des deux fichiers, laissant l'autre reference en 404.
const heroImg = await getImage({ src: heroImgSrc, width: 1920, quality: 72 });
// Versions plus legeres de la meme photo pour la balise <img> (mobile/tablette)
const heroPetite = await getImage({ src: heroImgSrc, width: 640, quality: 72 });
const heroMoyenne = await getImage({ src: heroImgSrc, width: 1100, quality: 72 });
---

<section class="heroSection" data-masque-bulle style={`--hero-bg:url(${heroImg.src})`}>
    <!-- Sur mobile/tablette, la photo s'affiche seule (pas de filtre sombre
         dessus) au-dessus du bloc texte, au lieu de lui servir de fond :
         voir HeroSection.css. Invisible sur desktop (le fond CSS existant
         reste utilisé la). -->
    <img class="photoHeroMobile" src={heroMoyenne.src} srcset={`${heroPetite.src} 640w, ${heroMoyenne.src} 1100w, ${heroImg.src} 1920w`} sizes="100vw" width={heroImg.attributes.width} height={heroImg.attributes.height} alt="Maison rénovée par MIPE Habitat" fetchpriority="high" loading="eager" decoding="async" />
    <div class="hero">
        <div class="text">
            <span class="miniTitre" >Rénovation énergétique . Oise</span>
            <h1>La rénovation énergétique, simple et accompagnée</h1>
            <p>Façade, isolation, menuiseries : MIPE Habitat vous accompagne dans tous vos projets de rénovation de l'habitat</p>
                <div class="checkContainer">
                    <p><Check size={15} color="#8FE05C"/>Devis gratuit et sans engagement</p>
                    <p><Check size={15} color="#8FE05C"/> Étude personnalisée de votre projet à domicile</p>
                    <p><Check size={15} color="#8FE05C"/> Accompagnement dans vos démarches d'aides à la rénovation</p>
                </div>

                <div class="certifsHero">
                    <a href="/qualifications" class="badgeCertifHero" aria-label="Voir nos qualifications RGE Qualibat">
                        <Image src={logoRge} alt="RGE Qualibat" width={160} />
                    </a>
                    <a href="/qualifications" class="badgeCertifHero" aria-label="Voir nos qualifications RGE Certibat">
                        <Image src={logoCertibat} alt="RGE Certibat" width={160} />
                    </a>
                    <a href="https://www.ffbatiment.fr" target="_blank" rel="noopener" class="badgeCertifHero" aria-label="MIPE Habitat, adhérent de la Fédération Française du Bâtiment">
                        <Image src={logoFfb} alt="FFB, Fédération Française du Bâtiment" width={160} />
                    </a>
                    <a href="https://www.reseau-proeco-energies.fr" target="_blank" rel="noopener" class="badgeCertifHero" aria-label="MIPE Habitat, membre du réseau proéco-énergies">
                        <Image src={logoProeco} alt="Réseau proéco-énergies" width={295} height={116} />
                    </a>
                </div>

        </div>
        <div class="form">
            <FormHero></FormHero>
        </div>
    </div>

    <!-- Le bandeau de chiffres-cles fait desormais partie de la hero section
         elle-meme (et non plus d'une section separee en dessous) : sur
         desktop, toute la hero (texte + formulaire + bandeau) tient dans un
         seul ecran, sans avoir a scroller pour decouvrir le bandeau. -->
    <div class="sectionBandeau">
        <div class="bandeau">
            <!-- Note avis : seule case qui garde un fond (petite carte sombre),
                 pour se lire comme un vrai badge de confiance - les 3 autres
                 chiffres sont poses directement sur la photo. -->
            <a class="carteAvisBandeau reveal" href="https://www.google.com/search?q=MIPE+Habitat+Le+Plessis-Belleville+avis" target="_blank" rel="noopener noreferrer" aria-label="Voir nos avis sur Google (nouvel onglet)">
                <div class="noteAvisBandeau">
                    <svg class="logoGoogleBandeau" viewBox="0 0 48 48" width="26" height="26" role="img" aria-label="Google">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    <span class="chiffreNoteBandeau">4,8</span>
                    <div class="etoilesAvisBandeau" aria-hidden="true">
                        <Star size={14} color="#F5A623" fill="#F5A623" />
                        <Star size={14} color="#F5A623" fill="#F5A623" />
                        <Star size={14} color="#F5A623" fill="#F5A623" />
                        <Star size={14} color="#F5A623" fill="#F5A623" />
                        <Star size={14} color="#F5A623" fill="#F5A623" />
                    </div>
                </div>
                <p class="sousNoteBandeau">+ de 250 avis Google</p>
            </a>
            <div class="date statBandeau reveal">
                <span class="ligneAccentBandeau"></span>
                <p class="chiffreBandeau"><span class="chiffreAnime" data-cible="15">0</span> ans</p>
                <p class="sousCat">d'expérience, depuis 2011</p>
            </div>
            <div class="chantiers statBandeau reveal">
                <span class="ligneAccentBandeau"></span>
                <p class="chiffreBandeau"><span class="plusBandeau">+</span><span class="chiffreAnime" data-cible="3000">0</span></p>
                <p class="sousCat">chantiers réalisés</p>
            </div>
            <div class="localisation statBandeau reveal">
                <span class="ligneAccentBandeau"></span>
                <p class="chiffreBandeau"><span class="chiffreAnime" data-cible="2">0</span> agences</p>
                <p class="sousCat">Plessis-Belleville & Plaisir</p>
            </div>
        </div>
    </div>
</section>

<script src="../js/compteurBandeau.js"></script>
<script src="../js/heroViewportFit.js"></script>