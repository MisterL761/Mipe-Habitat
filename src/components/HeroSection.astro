---
import { Check } from '@lucide/astro';
import '../styles/styleComponents/HeroSection.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import heroImgSrc from '../assets/image/ImageHero.webp';
import FormHero from './FormHero.astro';

// Une seule image generee (getImage), reutilisee pour les deux usages (fond
// CSS desktop + balise <img> mobile) : en utilisant <Image> ET un
// background-image url() separement sur la meme source, Astro finissait par
// n'ecrire qu'un seul des deux fichiers, laissant l'autre reference en 404.
const heroImg = await getImage({ src: heroImgSrc, width: 1920 });
---

<section class="heroSection" style={`--hero-bg:url(${heroImg.src})`}>
    <!-- Sur mobile/tablette, la photo s'affiche seule (pas de filtre sombre
         dessus) au-dessus du bloc texte, au lieu de lui servir de fond :
         voir HeroSection.css. Invisible sur desktop (le fond CSS existant
         reste utilisé la). -->
    <img class="photoHeroMobile" src={heroImg.src} alt="Maison rénovée par MIPE Habitat" />
    <div class="hero">
        <div class="text">
            <span class="miniTitre" >Rénovation énergétique . Oise</span>
            <h1>La rénovation énergétique, sans le casse-tête</h1>
            <p>Façade, isolation, menuiseries : MIPE Habitat vous accompagne dans tous vos projets de rénovation de l'habitat</p>
                <div class="checkContainer">
                    <p><Check size={15} color="#8FE05C"/>Devis gratuit et sans engagement</p>
                    <p><Check size={15} color="#8FE05C"/> Étude personnalisée de votre projet à domicile</p>
                    <p><Check size={15} color="#8FE05C"/> Accompagnement dans vos démarches d'aides à la rénovation</p>
                </div>

        </div>
        <div class="form">
            <FormHero></FormHero>
        </div>
    </div>
</section>

<section>
    <div class="bandeau">
        <div class="date reveal">
            <p class="cat"><strong>Depuis 2011</strong></p>
            <p class="sousCat"><span class="chiffreAnime" data-cible="15">0</span> ans d'expérience</p>
        </div>
        <div class="rge reveal">
            <p class="cat"><strong>RGE Qualibat</strong></p>
            <p class="sousCat">Entreprise certifiée</p>
        </div>
        <div class="garantie reveal">
            <p class="cat"><strong>Travaux garantis</strong></p>
            <p class="sousCat">Selon les garanties applicables</p>
        </div>
        <div class="localisation reveal">
            <p class="cat"><strong>2 implantations</strong></p>
            <p class="sousCat">Plessis-Belleville & Plaisir</p>
        </div>
    </div>
</section>

<script src="../js/compteurBandeau.js"></script>