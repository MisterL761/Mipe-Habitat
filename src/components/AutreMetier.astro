---
import '../styles/styleComponents/AutreMetier.css';
import '../styles/global.css'
import { Image } from 'astro:assets';

import photoRavalement from '../assets/image/ravalement.webp';
import photoCombles from '../assets/image/amenagement-comble.webp';
import photoToiture from '../assets/image/toiture.webp';



const autreMetier = [
    { photo: photoRavalement, prestation: 'Ravalement de façade', href: '/ravalement-de-facade', description: 'Rénovez, protégez et embellissez vos façades pour redonner durablement de la valeur à votre habitation.' },
    { photo: photoCombles, prestation: 'Aménagement des combles', href: '/amenagement-combles', description: 'Transformez vos combles en nouveaux espaces de vie, adaptés à vos besoins et à votre habitation.' },
    { photo: photoToiture, prestation: 'Travaux de toiture', href: '/entretien-toiture', description: 'Entretien, réparation et rénovation pour préserver durablement la couverture et l’étanchéité de votre habitation.' },



];
---

<section class="reveal">

        <p class="petitTitreAutreMetier">Aussi disponible</p>
        <h2 class="titreAutreMetier">Nos autres métiers</h2>
        <br>
        <p class="textAutreMetier">Entretenir, rénover et valoriser votre habitat</p>
        <p class="textAutreMetier bottomAutreMetier">Au-delà de la rénovation énergétique, MIPE Habitat vous accompagne également dans l’entretien et l’amélioration de votre maison.</p>

        <div class="autreMetierContainer" >
            {
                autreMetier.map(({ photo, prestation, description, href }) => (
                        <div class="cardAutreMetier">
                            <div class="photoAutreMetier"><Image src={photo} alt={prestation} /></div>
                            <div class="contenuCardAutreMetier">
                                <p class="titrePrestationAutreMetier"><a href={href} class="lienCarte">{prestation}</a></p>
                                <p class="descriptionAutreMetier">{description}</p>
                            </div>
                        </div>
                ))
            }
        </div>

</section>
