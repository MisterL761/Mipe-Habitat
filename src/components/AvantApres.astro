---
import { ChevronsLeftRight, ArrowRight, Images, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import '../styles/styleComponents/AvantApres.css';

// Attention, piege : sur le disque, le fichier nomme "avant.webp" montre en
// realite la maison DEJA renovee (enduit propre, toiture nettoyee), et
// "apres.webp" montre son etat D'ORIGINE (facade sale, volets abimes,
// materiel de chantier au sol) - les deux noms sont inverses par rapport a
// leur contenu reel. On les importe donc ici sous des noms qui decrivent
// ce qu'ils montrent vraiment, pas le nom du fichier source.
import photoEtatOrigine from '../assets/image/apres.webp';
import photoRenovee from '../assets/image/avant.webp';

// Chantier montre par le curseur : Saint-Mard (77), ITE 2021. Ses 4 photos
// (memes fichiers que sur la carte de la page Realisations) s'ouvrent dans une
// popup, sans quitter l'accueil. "avant.webp"/"apres.webp" ci-dessus sont des
// copies de saint-mard4 (etat d'origine) et saint-mard1 (renove).
import saintMard1 from '../assets/realisation/saint-mard/boodhun-saint-mard1.webp';
import saintMard2 from '../assets/realisation/saint-mard/boodhun-saint-mard2.webp';
import saintMard3 from '../assets/realisation/saint-mard/boodhun-saint-mard3.webp';
import saintMard4 from '../assets/realisation/saint-mard/boodhun-saint-mard4.webp';
const photosChantier = [
	{ photo: saintMard4, etiquette: 'Avant', alt: "Maison de Saint-Mard avant l'intervention" },
	{ photo: saintMard2, etiquette: 'Pendant', alt: 'Chantier de Saint-Mard : pose des panneaux isolants' },
	{ photo: saintMard3, etiquette: 'Pendant', alt: 'Chantier de Saint-Mard : finitions' },
	{ photo: saintMard1, etiquette: 'Après', alt: 'Maison de Saint-Mard après la rénovation' },
];
---

<section class="reveal">
	<div class="containerAvantApres">
		<p class="petitTitre">Avant / Après</p>
		<h2 class="titreAvantApres">Le résultat, vu par vous-même</h2>
		<p class="descAvantApres">Faites glisser le curseur pour comparer l'état d'origine de cette maison et le résultat après notre intervention.</p>

		<div class="curseurAvantApresContainer">
			<div class="imagesAvantApres" id="imagesAvantApres">
				<Image src={photoRenovee} alt="Façade après la rénovation par MIPE Habitat" class="imgApres" />
				<Image src={photoEtatOrigine} alt="Façade avant intervention de MIPE Habitat" class="imgAvant" />

				<span class="etiquetteAvantApres etiquetteAvant">Avant</span>
				<span class="etiquetteAvantApres etiquetteApres">Après</span>

				<input type="range" min="0" max="100" value="50" class="curseurAvantApres" id="curseurAvantApres" aria-label="Curseur de comparaison avant/après" />

				<div class="poigneeAvantApres" aria-hidden="true">
					<ChevronsLeftRight size={36} strokeWidth={2.75} />
				</div>
			</div>
		</div>

		<dialog class="popupChantier" id="popupChantier" aria-labelledby="titrePopupChantier">
			<div class="enteteChantier">
				<div>
					<h3 class="titrePopupChantier" id="titrePopupChantier">Isolation thermique extérieure</h3>
					<p class="soustitrePopupChantier">Saint-Mard (77) · 2021</p>
				</div>
				<button type="button" class="fermerPopupChantier" id="fermerPopupChantier" aria-label="Fermer la fenêtre">
					<X size={20} />
				</button>
			</div>
			<div class="grillePopupChantier">
				{
					photosChantier.map(({ photo, etiquette, alt }) => (
						<figure class="photoPopupChantier">
							<Image src={photo} alt={alt} width={900} />
							<figcaption>{etiquette}</figcaption>
						</figure>
					))
				}
			</div>
		</dialog>

		<div class="boutonsAvantApres">
			<button type="button" class="boutonVoirChantier" id="boutonVoirChantier" aria-haspopup="dialog">
				<Images size={18} />
				Voir le chantier en photos
			</button>
			<a href="/realisation" class="lienToutesRealisationsAvantApres">
				Voir toutes nos réalisations
				<ArrowRight size={18} />
		</a>
		</div>
	</div>
</section>

<script src="../js/avantApres.js"></script>
<script src="../js/popupChantier.js"></script>
