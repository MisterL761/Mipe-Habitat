---
import { Image } from 'astro:assets';
import franceRenov from '../assets/image/franceRenov.jpg.webp';
import repFrancaise from '../assets/image/repFrancaise.webp';

import '../styles/styleComponents/BandeauFranceRenov.css';
---

<section class="reveal">
    <div class="bandeauFranceRenov">
        <div class="logoRep">
            <Image
                    src={repFrancaise}
                    alt="logo de la république française "
                    width={125}
            />
        </div>
        <div class="logoRenov">
            <Image
                    src={franceRenov}
                    alt="logo de la France Rénov"
                    width={200}
            />
        </div>
        <div class="textFranceRenov">
            <p>Avant de vous engager, le service public vous informe gratuitement pour préparer et sécuriser votre projet : <a href="https://france-renov.gouv.fr">france-renov.gouv.fr</a> </p>
        </div>
    </div>
</section>