---
import { Check, ArrowRight } from '@lucide/astro';
import '../styles/styleComponents/Simulateur.css';
import '../styles/global.css'

// L'echelle DPE (de A, le plus econome, a G, le plus energivore) est
// construite ici en CSS (plus une image) pour pouvoir l'animer : chaque
// bande "pousse" depuis la gauche quand on arrive sur la section, dans
// l'ordre G -> A (voir le style "--delai" plus bas et Simulateur.css).
const classesDpe = [
	{ lettre: 'A', couleur: '#00923F', largeur: 46 },
	{ lettre: 'B', couleur: '#4CAF1C', largeur: 55 },
	{ lettre: 'C', couleur: '#9DCB3B', largeur: 64 },
	{ lettre: 'D', couleur: '#FFDE00', largeur: 73 },
	{ lettre: 'E', couleur: '#FBA919', largeur: 82 },
	{ lettre: 'F', couleur: '#F3701C', largeur: 91 },
	{ lettre: 'G', couleur: '#E30613', largeur: 100 },
];
---

<section class="reveal simulateurSection">

    <div class="SimulateurContainer">
        <div class="textSimulateur">
            <h2>Accédez gratuitement à notre simulateur MIPéconomie</h2>

            <p class="descSimulateur">Vous envisagez des travaux de rénovation énergétique et vous ne savez pas par où commencer ? En moins de 3 minutes, notre simulateur énergétique gratuit vous permet d’obtenir une vision claire et personnalisée de votre projet.</p>
            <p class="descSimulateur2">Grâce à MIPéconomie, vous pouvez :</p>

            <div class="checkContainer">

                <p><Check size={15} color="#8FE05C"/>Identifier les travaux de rénovation énergétique à prioriser selon l’état et les performances de votre logement ;</p>
                <p><Check size={15} color="#8FE05C"/>Découvrir les aides financières auxquelles vous pouvez prétendre et estimer votre reste à charge ;</p>
                <p><Check size={15} color="#8FE05C"/>Estimer vos futures économies d’énergie ;</p>
                <p><Check size={15} color="#8FE05C"/>Mesurer l’amélioration de votre DPE et la réduction potentielle de vos émissions de CO₂ ;</p>
                <p><Check size={15} color="#8FE05C"/>Évaluer l’évolution de la valeur de votre bien immobilier après rénovation.</p>

            </div>



            <a href="https://www.mipe-group.com/page/simulator" target="_blank" rel="noopener noreferrer" class="btnSimulation">Demarrer ma simulation <ArrowRight size={15} /></a>
        </div>


        <div class="imageSimulateur">
            <div class="echelleDpe" role="img" aria-label="Échelle des classes énergétiques, de A à G">
                {
                    classesDpe.map(({ lettre, couleur, largeur }, index) => (
                        <div
                            class="bandeDpe reveal"
                            style={`--couleur-bande:${couleur}; --largeur-bande:${largeur}%; transition-delay:${(classesDpe.length - 1 - index) * 0.12}s;`}
                        >
                            <span class="lettreDpe">{lettre}</span>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

</section>
