---
import { Gift, X, Check, ArrowRight } from '@lucide/astro';
import '../styles/styleComponents/OffreEnCours.css';
---

<!-- L'onglet et la popup sont construits par offreEnCours.js à partir de la première
     promotion active gérée dans l'admin (la même liste alimente la page /promotions). -->
<div id="offreRacine"></div>

<template id="offreIcones">
	<span data-i="gift"><Gift size={20} /></span>
	<span data-i="x"><X size={20} /></span>
	<span data-i="check"><Check size={16} color="#6FBE2C" /></span>
	<span data-i="fleche"><ArrowRight size={16} /></span>
</template>

<script src="../js/offreEnCours.js"></script>
