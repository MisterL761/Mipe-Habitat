---
import { Gift, X, Check, ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import '../styles/styleComponents/OffreEnCours.css';
import offrePanneauImg from '../assets/image/offre-panneau.webp';

// Offre en cours (kit solaire offert). "dateFin" reste a null : l'offre est
// limitee par le stock disponible, pas par une date precise - pas de compte
// a rebours invente, juste la mention "dans la limite des stocks".
const offre = {
	kicker: 'Offre en cours',
	titre: 'Un kit solaire offert avec vos travaux',
	intro: 'Pour tout dossier de rénovation signé à partir de 9 000 €, nous vous offrons un kit solaire Plug & Play 410 W.',
	points: [
		"Valable pour vos projets ITE, ravalement de façade et menuiseries",
		'Jusqu’à 670 kWh produits par an*',
		'Jusqu’à 120 € d’économies par an*',
		'Installation simple : au sol, en terrasse, sur un balcon ou un mur',
	],
	disclaimer: '*Production et économies estimées, variables selon l’exposition, la localisation et les conditions d’utilisation.',
	dateFin: null,
	validite: 'Offre valable dans la limite des stocks disponibles.',
	cta: { texte: 'Découvrir l’offre', lien: '/demander-un-devis' },
};

const dateFinFormatee = offre.dateFin
	? new Date(offre.dateFin).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
	: null;
---

<button type="button" id="offreTab" class="offreTab" aria-haspopup="dialog" aria-controls="offreModal">
	<Gift size={20} />
	<span class="offreTabLabel">Offres en cours</span>
	<span class="offreTabJours" id="offreTabJours"></span>
</button>

<div id="offreModal" class="offreModal" role="dialog" aria-modal="true" aria-labelledby="offreTitre" hidden>
	<div class="offreScrim" id="offreScrim"></div>
	<div class="offrePanneau">
		<button type="button" id="offreClose" class="offreClose" aria-label="Fermer">
			<X size={20} />
		</button>

		<div class="offrePhotoWrap">
			<Image src={offrePanneauImg} alt="Kit solaire Plug & Play installé sur une terrasse" width={560} quality={70} />
		</div>

		<div class="offreContenu">
			<p class="offreKicker">{offre.kicker}</p>
			<h2 id="offreTitre" class="offreTitreModal">{offre.titre}</h2>
			<p class="offreIntro">{offre.intro}</p>

			<ul class="offrePoints">
				{offre.points.map((point) => (
					<li>
						<Check size={16} color="#6FBE2C" />
						<span>{point}</span>
					</li>
				))}
			</ul>

			{offre.dateFin && (
				<div class="offreCompteur" id="offreCompteur" data-fin={offre.dateFin}>
					<div class="cdBloc"><span id="cdJours">00</span><small>jours</small></div>
					<div class="cdBloc"><span id="cdHeures">00</span><small>h</small></div>
					<div class="cdBloc"><span id="cdMinutes">00</span><small>min</small></div>
					<div class="cdBloc"><span id="cdSecondes">00</span><small>sec</small></div>
				</div>
			)}

			<p class="offreDisclaimer">{offre.disclaimer}</p>
			<p class="offreValidite">{offre.dateFin ? `Offre valable jusqu’au ${dateFinFormatee}.` : offre.validite}</p>

			<a href={offre.cta.lien} class="offreCta">
				{offre.cta.texte}
				<ArrowRight size={16} />
			</a>
		</div>
	</div>
</div>

<script src="../js/offreEnCours.js"></script>
