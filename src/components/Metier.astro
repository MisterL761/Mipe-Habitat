---
import '../styles/styleComponents/Metier.css';
import '../styles/global.css';
import { Image } from 'astro:assets';

import photoIte from '../assets/image/iso-ext.webp';
import photoIti from '../assets/image/iti.webp';
import photoCombles from '../assets/image/comble.webp';
import photoMenuiseries from '../assets/image/menuiserie.webp';
import photoEnergie from '../assets/image/clim.webp';

const metier = [
    { photo: photoIte, prestation: 'Isolation thermique extérieure (ITE)', description: 'Une solution performante pour isoler les murs par l’extérieur et limiter durablement les déperditions de chaleur.' },
    { photo: photoIti, prestation: 'Isolation thermique intérieure (ITI)', description: 'Une alternative efficace pour améliorer l’isolation de votre logement lorsque l’ITE n’est pas adaptée.' },
    { photo: photoCombles, prestation: 'Isolation des combles & rampants', description: 'Combles perdus ou toiture en rampant : améliorez l’isolation de votre toiture pour limiter les déperditions de chaleur et gagner en confort toute l’année.' }


];
const metier2 = [
    { photo: photoMenuiseries, prestation: 'Menuiseries extérieures', description: 'Fenêtres et portes performantes pour renforcer l’isolation et le confort de votre habitat.' },
    { photo: photoEnergie, prestation: 'Énergie, chauffage & ventilation', description: 'Pompes à chaleur, solutions de chauffage et systèmes de ventilation performants, installés par notre réseau de partenaires qualifiés pour améliorer le confort et la performance énergétique de votre logement.' }
];


---

<section class="reveal">
    <div class="metierContainer">
        <p class="petitTitre petitTitreMetier">Rénovation énergétique - Notre cœur de métier</p>
        <h2 class="titreMetier">Améliorer durablement la performance de votre habitat</h2>
        <p class="descMetier">Isolation, menuiseries et chauffage : des solutions complémentaires pour réduire <br> les déperditions, améliorer votre confort et optimiser les performances <br> énergétiques de votre logement.</p>

            <div class="metierContainerCard" >
                {
                    metier.map(({ photo, prestation, description }) => (
                            <div class="cardMetier">
                                <div class="photoMetier"><Image src={photo} alt={prestation} /></div>
                                <div class="contenuCardMetier">
                                    <p class="titrePrestation">{prestation}</p>
                                    <p class="descriptionMetier">{description}</p>
                                </div>
                            </div>
                    ))
                }
            </div>

        <div class="metierContainerCard" >
            {
                metier2.map(({ photo, prestation, description }) => (
                        <div class="cardMetier">
                            <div class="photoMetier"><Image src={photo} alt={prestation} /></div>
                            <div class="contenuCardMetier">
                                <p class="titrePrestation">{prestation}</p>
                                <p class="descriptionMetier">{description}</p>
                            </div>
                        </div>
                ))
            }
        </div>


    </div>

</section>
