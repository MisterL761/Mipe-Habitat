---
import '../styles/styleComponents/Metier.css';
import '../styles/global.css';

import { BrickWall, Grid2x2, Triangle, DoorOpen, HousePlug} from '@lucide/astro';

const metier = [
    { icone: BrickWall, prestation: 'Isolation thermique extérieure (ITE)', description: 'Une solution performante pour isoler les murs par l’extérieur et limiter durablement les déperditions de chaleur.' },
    { icone: Grid2x2, prestation: 'Isolation thermique intérieure (ITI)', description: 'Une alternative efficace pour améliorer l’isolation de votre logement lorsque l’ITE n’est pas adaptée.' },
    { icone: Triangle, prestation: 'Isolation des combles & rampants', description: 'Combles perdus ou toiture en rampant : améliorez l’isolation de votre toiture pour limiter les déperditions de chaleur et gagner en confort toute l’année.' }


];
const metier2 = [
    { icone: DoorOpen, prestation: 'Menuiseries extérieures', description: 'Fenêtres et portes performantes pour renforcer l’isolation et le confort de votre habitat.' },
    { icone: HousePlug, prestation: 'Énergie, chauffage & ventilation', description: 'Pompes à chaleur, solutions de chauffage et systèmes de ventilation performants, installés par notre réseau de partenaires qualifiés pour améliorer le confort et la performance énergétique de votre logement.' }
];


---

<section class="reveal">
    <div class="metierContainer">
        <p class="petitTitre petitTitreMetier">Rénovation énergétique - Notre cœur de métier</p>
        <h2 class="titreMetier">Améliorer durablement la performance de votre habitat</h2>
        <p class="descMetier">Isolation, menuiseries et chauffage : des solutions complémentaires pour réduire <br> les déperditions, améliorer votre confort et optimiser les performances <br> énergétiques de votre logement.</p>

            <div class="metierContainerCard" >
                {
                    metier.map(({ icone: Icone, prestation, description }) => (
                            <div class="cardMetier">
                                <p class="iconeMetier"><Icone size={25} color="#3E7C1F" /></p>
                                <p class="titrePrestation">{prestation}</p>
                                <p class="descriptionMetier">{description}</p>
                            </div>
                    ))
                }
            </div>

        <div class="metierContainerCard" >
            {
                metier2.map(({ icone: Icone, prestation, description }) => (
                        <div class="cardMetier">
                            <p class="iconeMetier"><Icone size={25} color="#3E7C1F" /></p>
                            <p class="titrePrestation">{prestation}</p>
                            <p class="descriptionMetier">{description}</p>
                        </div>
                ))
            }
        </div>


    </div>

</section>