<section class="sectionSocial reveal">
	<div class="bandeauSocial">
		<div class="texteSocial">
			<p class="petitTitre">Réseaux sociaux</p>
			<h2 class="titreSocial">Suivez-nous</h2>
		</div>

		<div class="iconesSocial">
			<a href="https://www.tiktok.com/@mipe.habitat" target="_blank" class="lienSocial" aria-label="TikTok">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M16.5 3c.4 2.2 2 3.8 4.2 4.1v3c-1.6 0-3.1-.5-4.3-1.4v6.6c0 3.7-3 6.7-6.7 6.7S3 19 3 15.3s3-6.7 6.7-6.7c.4 0 .8 0 1.2.1v3.2c-.4-.1-.8-.2-1.2-.2-1.9 0-3.4 1.5-3.4 3.4s1.5 3.4 3.4 3.4 3.5-1.5 3.5-3.4V3h3.3Z"/></svg>
			</a>
			<a href="https://www.instagram.com/mipehabitat/" target="_blank" class="lienSocial" aria-label="Instagram">
