				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M14 13.5h2.5l.5-3H14V8.5c0-.9.3-1.5 1.6-1.5H17V4.1C16.7 4.1 15.8 4 14.7 4 12.5 4 11 5.3 11 7.8V10.5H8.5v3H11V21h3V13.5Z"/></svg>
			</a>
		</div>
	</div>
</section>
