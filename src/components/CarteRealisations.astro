// Pour la carte Leaflet (script JS classique, pas de traitement Astro des
// images) : on ne transmet que l'URL finale de chaque photo (photo.src),
// pas l'objet Image complet. Le tableau "chantiers" original, lui, garde
// les vrais objets Image pour que la grille du bas beneficie de
// l'optimisation automatique des images d'Astro.
const chantiersPourCarte = chantiers.map((chantier) => ({
	...chantier,
	photos: (chantier.photos || []).map((photo) => photo.src),
}));
---

<section class="reveal">
	<div class="containerRealisations">
		<div class="heroPage">
		<p class="petitTitre">Nos réalisations</p>
		<h1 class="titreRealisations">Des chantiers menés dans tout le secteur</h1>
		<p class="textRealisations">Cliquez sur un point de la carte pour découvrir le chantier réalisé par nos équipes.</p>
		</div>

		<div class="carteContainer">
			<div id="carte" data-siege={JSON.stringify(siege)} data-chantiers={JSON.stringify(chantiersPourCarte)}></div>

			<div class="cardChantier" id="cardChantier" hidden>
				<button type="button" class="fermerCard" id="fermerCard" aria-label="Fermer">
					<X size={16} />
				</button>
				<div class="galerieChantier">
					<div class="galerieTrack" id="galerieCardTrack">
						<div class="imageChantier"><ImageIcon size={28} color="#A9B2BA" /></div>
					</div>
					<button type="button" class="galeriePrec" id="galerieCardPrec" hidden aria-label="Photo précédente">‹</button>
					<button type="button" class="galerieSuiv" id="galerieCardSuiv" hidden aria-label="Photo suivante">›</button>
				</div>
				<div class="contenuCardChantier">
					<div class="tagsChantier">
						<span class="tagCategorie" id="cardCategorie"></span>
						<span class="tagAnnee" id="cardAnnee"></span>
					</div>
					<p class="titreCardChantier" id="cardTitre"></p>
					<p class="lieuCardChantier" id="cardLieu"></p>
					<p class="descCardChantier" id="cardDesc"></p>
				</div>
			</div>

			<div class="legendeCarte">
				<span class="itemLegende"><span class="pointLegende pointSiege"></span>Siège MiPe Habitat</span>
				<span class="itemLegende"><span class="pointLegende pointChantier"></span>Chantier réalisé</span>
			</div>
		</div>

		<h2 class="titreToutesRealisations">Toutes nos réalisations</h2>
		<div class="grilleRealisations">
			{
				chantiers.map(({ titre, ville, cp, photos }, index) => (
					<div class="carteRealisation" hidden={index >= NB_REALISATIONS_INITIAL}>
						{photos && photos.length > 0 ? (
							<div class="galerieChantier">
								<div class="galerieTrack">
									{photos.map((photo) => (
										<Image src={photo} alt={titre} />
									))}
								</div>
								{photos.length > 1 && (
									<Fragment>
										<button type="button" class="galeriePrec" aria-label="Photo précédente">‹</button>
										<button type="button" class="galerieSuiv" aria-label="Photo suivante">›</button>
									</Fragment>
								)}
							</div>
						) : (
							<div class="imageChantier"><ImageIcon size={28} color="#A9B2BA" /></div>
						)}
						<p class="titreCarteRealisation">{titre}</p>
						<p class="lieuCarteRealisation">{ville} ({cp})</p>
					</div>
				))
			}
		</div>

		{chantiers.length > NB_REALISATIONS_INITIAL && (
			<button type="button" class="btnVoirPlusRealisations" id="btnVoirPlusRealisations" data-par-lot={NB_REALISATIONS_INITIAL}>
				Voir plus de réalisations
			</button>
		)}
	</div>
</section>

<script src="../js/leaflet.js"></script>
<script src="../js/voirPlusRealisations.js"></script>
