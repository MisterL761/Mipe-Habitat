---
import { Home, ChevronRight } from '@lucide/astro';
// Fil d'Ariane reutilisable : "items" est la liste des etapes apres
// "Accueil" (toujours ajoute automatiquement en premier). Chaque etape a
// un "href" (lien cliquable) sauf la derniere, qui represente la page
// actuelle et s'affiche sans lien.
interface Props {
	items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="filAriane" aria-label="Fil d'Ariane">
	<ol class="filArianeListe">
		<li>
			<a href="/" class="filArianeLien filArianeAccueil"><Home size={15} aria-hidden="true" /><span>Accueil</span></a>
		</li>
		{
			items.map(({ label, href }) => (
				<li>
					<ChevronRight class="filArianeSep" size={15} aria-hidden="true" />
					{href ? <a href={href} class="filArianeLien">{label}</a> : <span class="filArianePage" aria-current="page">{label}</span>}
				</li>
			))
		}
	</ol>
</nav>
