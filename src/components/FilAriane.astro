---
// Fil d'Ariane reutilisable : "items" est la liste des etapes apres
// "Accueil" (toujours ajoute automatiquement en premier). Chaque etape a
// un "href" (lien cliquable) sauf la derniere, qui represente la page
// actuelle et s'affiche sans lien.
interface Props {
	items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="filAriane" aria-label="Fil d'Ariane">
	<a href="/">Accueil</a>
	{
		items.map(({ label, href }) => (
			<>
				<span>/</span>
				{href ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}
			</>
		))
	}
</nav>
