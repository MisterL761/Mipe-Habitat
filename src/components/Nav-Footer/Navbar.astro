---
import { Image } from 'astro:assets';
import logoImage from '../../assets/logo-mipe-habitat.jpeg';
import {ChevronDown, Menu, X, CalendarClock, Check} from '@lucide/astro';
import '../../styles/styleComponents/Nav-Footer/Navbar.css';
import '../../styles/global.css';

interface Props {
	logo?: string;
}

const liens = [
	{ href: '/', label: 'Accueil' },
	{
		href: '/prestations',
		label: 'Nos métiers',
		fleche: true ,

		sousMenu:[

			{href : '/nos-metiers', label: 'Tous nos métiers'},
			{href : '/isolation-thermique-exterieur', label: 'Isolation thermique extérieure'},
			{href : '/isolation-thermique-interieur', label: 'Isolation thermique intérieure'},
			{href : '/menuiseries', label: 'Menuiserie'},
			{href : '/isolation-des-combles', label: 'Isolation des combles'},
			{href : '/ravalement-de-facade', label: 'Ravalement de façade'},
			{href : '/entretien-toiture', label: 'Nettoyage & entretien de toiture'},
			{href : '/amenagement-combles', label: 'Aménagement des combles'},
			{href : '/energie-chauffage-ventilation', label: 'Énergie, chauffage & ventilation'},

		],
	},
	{ href: '/realisation', label: 'Nos réalisations'},
	{
		href: '/ressources',
		label: 'Ressources',
		fleche: true,

		sousMenu:[
			{href : '/qualifications', label: 'Qualification'},
			{href : '/aides-et-financements', label: 'Aides et financements'},
			{href : '/nos-secteurs-intervention', label: 'Nos secteurs d\'intervention'},
			{href : '/blog', label: 'Blog'},
		],
	},
	{ href: '/professionnels', label: 'Professionnels' },
	{ href: 'https://revelhome.app/connexion?slug=' , label: 'Espace client' },
	
];
const pageActuelle = Astro.url.pathname;
---

<header class="navbar" id="navbar">
	<Image class="logo" src={logoImage} alt={"Image du logo"} />

	<button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="navbar">
		<Menu class="iconeBurger iconeBurgerOuvrir" size={24} />
		<X class="iconeBurger iconeBurgerFermer" size={24} />
	</button>

	<nav aria-label="Navigation principale">
		<ul>
			{
				liens.map(({ href, label, fleche, sousMenu }) => (
					<li class={sousMenu ? 'aSousMenu' : undefined}>
						<a href={href} class={sousMenu ? 'lienAvecMenu' : undefined} aria-current={pageActuelle === href ? 'page' : undefined}>
							{label}
							{fleche && <ChevronDown size={16} />}
						</a>

						{sousMenu && (
							<ul class="sousMenu">
								{sousMenu.map((item) => (
									<li><a href={item.href}>{item.label}</a></li>
								))}
							</ul>
						)}
					</li>
				))
			}

		</ul>
	</nav>

	<div class="contact">
		<a class="telephone" href="tel:0375190160">03 75 19 01 60</a>
		<a class="bouton-devis" href="/demander-un-devis"><CalendarClock class="calendar" size={20} color="#16273B"/>Prendre RDV</a>
	</div>
</header>

<script src="../../js/sousMenu.js"></script>
<script src="../../js/menuMobile.js"></script>



