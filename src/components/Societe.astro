---
import { Check } from '@lucide/astro';
import '../styles/global.css';
import '../styles/styleComponents/Societe.css';
import { Image } from 'astro:assets';
import interieur from '../assets/image/interieur.jpeg'
import exterieur from '../assets/image/exterieur.webp'

---

<section class="reveal">

    <div class="societeContainer">
        <div class="textSociete">
            <p class="petitTitre">NOTRE ENTREPRISE</p>
            <h2 class="titreSociete">Une entreprise à votre service</h2>
            <p class="descSociete">Depuis 2011, MIPE Habitat accompagne les particuliers dans leurs travaux de rénovation énérgétique depuis Le Plessis-Belleville, avec une équipe qualifiée spécialisée dans la performance de l'habitat</p>

            <div class="checkContainer">
                <p class="check"><Check size={15} color="#8FE05C"/>Certifiés RGE Qualibat pour nos travaux de rénovation énergétique</p>
                <p class="check"><Check size={23} color="#8FE05C"/> Votre projet en toute sérénité : nos travaux bénéficient des garanties légales et professionnelles applicables selon la nature des prestations réalisées.</p>
                <p class="check"><Check size={15} color="#8FE05C"/>Un accompagnement personnalisé pour vos démarches d’aides à la rénovation</p>
            </div>

            <button class="boutonSociete">Nous contacter</button>
            <!-- Fleche decorative en vague qui part du texte et pointe vers la frise juste en dessous -->
            <svg class="flecheFrise" viewBox="0 0 120 250" fill="none" aria-hidden="true" focusable="false">
                <path class="flecheFriseTrait" pathLength="1" d="M26 6 C96 30 -6 76 62 118 C112 150 22 186 66 236" />
                <path class="flecheFrisePointe" d="M66 236 L46 214 M66 236 L92 220" />
            </svg>


        </div>
        <div class="photosSociete">
            <div class="imageExterieur">
                <Image
                        src={exterieur}
                        alt="Vue d'exterieur de MIPE Habitat"
                        width={700}
                />
            </div>
            <div class="imageInterieur">
                <Image
                        src={interieur}
                        alt="Intérieur des locaux de MIPE Habitat"
                        width={500}
                />
            </div>
        </div>
    </div>
</section>