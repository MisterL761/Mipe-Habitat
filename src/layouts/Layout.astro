---
import '../styles/global.css';
// Polices hebergees avec le site (plus d'appel a Google Fonts : RGPD et rapidite)
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '@fontsource/outfit/latin-700.css';
import '@fontsource/outfit/latin-800.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/archivo/latin-900.css';
import { getImage } from 'astro:assets';
import imagePartage from '../assets/image/ImageHero.webp';
import BulleSimulation from '../components/BulleSimulation.astro';
import PastilleGoogle from '../components/PastilleGoogle.astro';
import OffreEnCours from '../components/OffreEnCours.astro';

interface Props {
	title?: string;
	description?: string;
}

// Valeurs par defaut pour les pages qui ne precisent pas encore title/description
// (remplacent l'ancien "Astro Basics" fige sur toutes les pages).
const {
	title = 'MIPE Habitat',
	description = "MIPE Habitat, votre partenaire de rénovation énergétique dans l'Oise et en Île-de-France : isolation, menuiseries, ravalement, toiture.",
} = Astro.props;

// Image d'apercu quand un lien du site est partage (Facebook, WhatsApp, LinkedIn...)
const apercu = await getImage({ src: imagePartage, width: 1200, format: 'jpg' });
const urlPage = new URL(Astro.url.pathname, Astro.site).href;
const urlApercu = new URL(apercu.src, Astro.site).href;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Lien relatif (pas de domaine en dur) : "site" n'est pas encore
		     defini dans astro.config.mjs, donc Astro.url.origin renverrait un
		     domaine de developpement au lieu du vrai domaine de production. -->
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="MIPE Habitat" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={urlPage} />
		<meta property="og:image" content={urlApercu} />
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />
	</head>
	<body class="site-body">
		<div class="site-contenu">
			<slot />
			<BulleSimulation></BulleSimulation>
			<PastilleGoogle></PastilleGoogle>
			<OffreEnCours></OffreEnCours>
		</div>

		<script src="../js/scrollReveal.js"></script>
		<script src="../js/bulleSimulationVisibilite.js"></script>
	</body>
</html>

<style>
	html {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		position: relative;
	}
	.site-contenu {
		position: relative;
		z-index: 1;
		width: 100%;
		min-height: 100%;
	}
</style>
