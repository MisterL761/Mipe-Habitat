---
import '../styles/refonteAccueil.css';
import Layout from "../layouts/Layout.astro";
import '../styles/global.css';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FilAriane from '../components/FilAriane.astro';
import '../styles/pages/nos-metiers.css';
import ite from '../assets/image/ite.jpeg';
import iti from '../assets/image/iti.webp';
import comble from '../assets/image/comble.webp';
import coulissant from '../assets/image/coulissant.webp';
import ravalement from '../assets/image/ravalement.webp';
import toiture from '../assets/image/toiture.webp';
import amenagement from '../assets/image/amenagement-comble.webp';
import clim from '../assets/image/clim.webp';
import { Image } from 'astro:assets';

const combinaisons = [
    { titre: 'Isolation extérieure + rénovation de façade', description: "Profitez d'un même chantier pour isoler vos murs et rénover l'aspect extérieur de votre habitation. Une intervention coordonnée pour gagner en performance et valoriser votre façade." },
    { titre: 'Isolation des combles + menuiseries', description: "Agissez sur plusieurs sources de déperdition en combinant l'isolation de la toiture avec des menuiseries plus performantes." },
    { titre: 'Isolation extérieure + menuiseries', description: "Associez l'ITE au remplacement de vos menuiseries pour améliorer la continuité de l'enveloppe thermique du logement et limiter les déperditions. Une intervention coordonnée permet également de mieux traiter les jonctions entre l'isolation et les ouvertures." },
];

const faqMetiers = [
    { question: 'Par quels travaux commencer ?', reponse: "Chaque logement est différent. Isolation des combles ou des murs, menuiseries, ventilation, chauffage... les priorités dépendent de l'état et des performances de votre habitation. Une étude du projet permet d'identifier les travaux les plus pertinents et leur ordre de réalisation.", ouvert: true },
    { question: 'Réalisez-vous les travaux avec vos propres équipes ?', reponse: 'Nos principaux métiers d’isolation et de rénovation de l’habitat sont réalisés par nos équipes et selon nos qualifications. Pour certaines prestations complémentaires, notamment chauffage, énergie et ventilation, nous nous appuyons sur un réseau de partenaires qualifiés.', ouvert: false },
    { question: 'Mes travaux sont-ils éligibles aux aides ?', reponse: "Cela dépend de la nature des travaux et de votre situation. CEE, MaPrimeRénov’ Rénovation d’ampleur, éco-PTZ, TVA à taux réduit ou aides locales peuvent être mobilisables selon votre projet. Nous vous orientons vers les dispositifs adaptés.", ouvert: false },
    { question: 'Dans quelle zone intervenez-vous ?', reponse: "MIPE Habitat intervient principalement dans l’Oise (60), la Seine-et-Marne (77), l’Aisne (02) et la Seine-Saint-Denis (93), ainsi qu’autour de notre implantation dans les Yvelines (78).", ouvert: false },
];

const prestaCard = [

    { image: ite, alt: 'image chantier isolation thermique extèrieur' , titre:'Isolation thermique extérieure', description:'Améliorez la performance de vos murs tout en préservant votre surface habitable.', href: '/isolation-thermique-exterieur' },
    { image: iti, alt: 'image chantier isolation thermique extèrieur' , titre:'Isolation thermique intérieure', description:'Une solution performante pour isoler vos murs lorsque l’isolation par l’extérieur n’est pas adaptée.', href: '/isolation-thermique-interieur' },
    { image: comble, alt: 'image chantier isolation thermique extèrieur' , titre:'Isolation des combles et rampants', description:'Limitez les déperditions par la toiture grâce à une isolation adaptée aux combles perdus ou aménagés.', href: '/isolation-des-combles' },
    { image: coulissant, alt: 'image chantier isolation thermique extèrieur' , titre:'Menuiseries extérieures', description:'Fenêtres, portes et baies performantes pour améliorer l’isolation thermique et le confort de votre logement.', href: '/menuiseries' },


];
const prestaCard2 = [

    { image: ravalement, alt: 'image chantier isolation thermique extèrieur' , titre:'Ravalement de façade', description:'Rénovation et protection durable des murs extérieurs.', href: '/ravalement-de-facade' },
    { image: clim, alt: 'image chantier isolation thermique extèrieur' , titre:'Énergie, chauffage et ventilation', description:'Des solutions performantes proposées avec notre réseau de partenaires qualifiés pour compléter votre projet de rénovation énergétique.', href: '/energie-chauffage-ventilation' },
    { image: toiture, alt: 'image chantier isolation thermique extèrieur' , titre:'Nettoyage et entretien de toiture', description:'Préservez votre couverture grâce à un entretien adapté et régulier.', href: '/entretien-toiture' },
    { image: amenagement, alt: 'image chantier isolation thermique extèrieur' , titre:'Aménagement des combles', description:'Transformez vos combles en nouveaux espaces de vie confortables et fonctionnels.', href: '/amenagement-combles' },

];
---
<Layout>
    <main>
        <Navbar></Navbar>
        <div class="refonte">
        <FilAriane items={[{ label: 'Nos métiers' }]} />

            <div class="heroNosMetiers">
                <p class="petitTitre">Nos métiers</p>
                <h1 class="titreNosMetiers">Tous vos travaux de rénovation, un seul interlocuteur</h1>
                <p class="descriptionNosMetiers">De l’isolation aux menuiseries, MIPE Habitat vous accompagne dans vos projets de rénovation énergétique et d’amélioration de l’habitat, dans l’Oise et en Île-de-France.</p>
            </div>

        <div class="pageNosMetiers">
        <section class="bandeMetiers bandeMetiersMenthe">
            <div class="renovationEnergetiqueMetiers">
                <p class="petitTitre">Rénovation énérgétique</p>
                <h2>L'isolation, notre cœur de métier</h2>
            </div>
            <div class="containerCardMetiers">
                {
                    prestaCard.map(({ image, alt , titre, description, href }) => (
                        <div class="cardMetiers">
                            <Image class="imageCard" src={image} alt={alt} />
                            <div class="contenuCardMetiers">
                                <h3 class="titreCardMetiers">{titre}</h3>
                                <p class="descriptionCardMetiers">{description}</p>
                                <a href={href} class="lienDecouvrirCardMetiers">Découvrir</a>
                            </div>
                        </div>
                    ))
                }
            </div>

        </section>

        <section class="bandeMetiers bandeMetiersBlanche">
            <h2 class="renoAmelioration">Rénovation et Amélioration de l’habitat</h2>

            <div class="containerCardMetiers">
                {
                    prestaCard2.map(({ image, alt , titre, description, href }) => (
                            <div class="cardMetiers">
                                <Image class="imageCard" src={image} alt={alt} />
                                <div class="contenuCardMetiers">
                                    <h3 class="titreCardMetiers">{titre}</h3>
                                    <p class="descriptionCardMetiers">{description}</p>
                                    <a href={href} class="lienDecouvrirCardMetiers">Découvrir</a>
                                </div>
                            </div>
                    ))
                }
            </div>

        </section>

        <section class="bandeMetiers bandeMetiersSombre">
            <div class="sectionCombinaison">
                <div class="combinaisonTexte">
                    <p class="petitTitre">Rénovation énergétique</p>
                    <h2 class="titreCombinaison">Associer les bons travaux pour gagner en performance</h2>
                    <p class="descCombinaison">Isolation des murs, combles, menuiseries, ventilation ou chauffage : combiner plusieurs travaux permet d'agir efficacement sur les différentes sources de déperdition et d'améliorer la performance globale de votre logement.</p>
                </div>
                <div class="combinaisonCards">
                    {
                        combinaisons.map(({ titre, description }) => (
                            <div class="carteCombinaison">
                                <p class="titreCarteCombinaison"><span class="pointCombinaison"></span>{titre}</p>
                                <p class="descCarteCombinaison">{description}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="bandeMetiers bandeMetiersFaq">
            <div class="sectionFaqMetiers">
                <div class="faqMetiersTexte">
                    <p class="petitTitre">Questions fréquentes</p>
                    <h2 class="titreFaqMetiers">Vos questions sur nos métiers</h2>
                </div>
                <div class="faqMetiersListe">
                    {
                        faqMetiers.map(({ question, reponse, ouvert }) => (
                            <details class="faqMetiersItem" open={ouvert}>
                                <summary class="questionFaqMetiers">{question}</summary>
                                <p class="reponseFaqMetiers">{reponse}</p>
                            </details>
                        ))
                    }
                </div>
            </div>
        </section>
        </div>
        </div>
        <Footer></Footer>
    </main>
</Layout>