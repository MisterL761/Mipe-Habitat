---
import '../styles/refonteAccueil.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FaqSchema from '../components/FaqSchema.astro';
import FilAriane from '../components/FilAriane.astro';
import '../styles/global.css';
import '../styles/pages/entretien-toiture.css';
import { Check, Sparkles, Search, Wrench } from '@lucide/astro';
import { Image } from 'astro:assets';

import photoToiture from '../assets/image/toiture.webp';

const interventions = [
	{
		Icone: Sparkles,
		titre: 'Démoussage et traitement à action lente',
		description: "Nous privilégions, lorsque cela est possible, l'application de produits professionnels à action lente, qui agissent progressivement sur les mousses, lichens et micro-organismes. Cette méthode permet de limiter le recours au nettoyage haute pression et de préserver les matériaux de couverture.",
	},
	{
		Icone: Search,
		titre: 'Inspection et entretien des gouttières',
		description: "Nous examinons l'état général de votre couverture et les points sensibles : tuiles, faîtages, raccords et évacuations d'eau. Le contrôle et l'entretien des gouttières contribuent à assurer une bonne évacuation des eaux pluviales et à prévenir les désordres liés à leur obstruction.",
	},
	{
		Icone: Wrench,
		titre: 'Petites réparations et étanchéité',
		description: "Tuiles déplacées ou endommagées, défauts ponctuels d'étanchéité, éléments de couverture à reprendre : nos équipes identifient les anomalies visibles et proposent les interventions adaptées, selon leur nature et leur importance.",
	},
];

const faqToiture = [
	{ question: "Pourquoi nettoyer et entretenir régulièrement sa toiture ?", reponse: "Avec le temps, mousses, lichens et salissures peuvent s'accumuler sur votre couverture et favoriser la rétention d'humidité. Un entretien adapté permet de préserver l'état des matériaux, de repérer les éventuelles dégradations et de prolonger la durée de vie de votre toiture.", ouvert: true },
	{ question: "À quelle fréquence faut-il entretenir sa toiture ?", reponse: "La fréquence dépend du type de couverture, de son ancienneté et de son exposition aux intempéries, aux arbres et à l'humidité. Une inspection régulière permet de déterminer si un nettoyage ou un traitement est nécessaire, sans intervenir inutilement.", ouvert: false },
	{ question: "Quels types de toitures pouvez-vous nettoyer ?", reponse: "MIPE Habitat intervient sur différents types de couvertures, notamment les tuiles en terre cuite, les tuiles béton et certaines couvertures en ardoise. Après examen de leur état, nos équipes sélectionnent une méthode de nettoyage et de traitement compatible avec les matériaux.", ouvert: false },
	{ question: "Le diagnostic et le devis sont-ils gratuits ?", reponse: "Oui, nos devis sont gratuits et sans engagement. Après un premier échange, un conseiller peut se déplacer pour examiner votre toiture, évaluer son état et vous proposer une solution d'entretien adaptée à votre couverture.", ouvert: false },
	{ question: "Faut-il appliquer un traitement hydrofuge après le nettoyage ?", reponse: "Un traitement hydrofuge peut être proposé selon la nature, la porosité et l'état de votre couverture. Il n'est pas systématiquement nécessaire. Nos équipes évaluent l'intérêt de ce traitement afin de vous proposer une solution adaptée, sans intervention superflue.", ouvert: false },
];
---

<Layout title="Nettoyage et entretien de toiture : démoussage | MIPE Habitat" description="Nettoyage et entretien de toiture pour supprimer mousses et lichens, éviter les infiltrations et prolonger la durée de vie de votre couverture. MIPE Habitat.">
	<main>
		<Navbar></Navbar>
		<div class="refonte">
		<FilAriane items={[{ label: 'Nos métiers', href: '/nos-metiers' }, { label: 'Nettoyage & entretien de toiture' }]} />

		<section class="containerImageDroite">
			<div class="containerParentImageDroite">
				<div class="textImageDroite">
					<p class="petitTitre">Toiture</p>
					<h1 class="titreImage">Un entretien adapté pour préserver durablement votre toiture</h1>
					<p class="descImage">Chaque couverture est différente. MIPE Habitat adapte ses méthodes d'entretien à la nature des matériaux, à leur état et au niveau d'encrassement, afin de proposer une intervention efficace et respectueuse de votre toiture.</p>
					<p class="check"><Check size={15} color="#8FE05C" />Démoussage et nettoyage adaptés aux matériaux</p>
					<p class="check"><Check size={15} color="#8FE05C" />Inspection et contrôle des gouttières</p>
					<p class="check"><Check size={15} color="#8FE05C" />Protection contre les infiltrations d’eau</p>
				</div>
				<div class="imageDroite">
					<Image src={photoToiture} alt="Nettoyage et entretien de toiture" />
				</div>
			</div>
		</section>

		<section class="sectionInterventionsToiture reveal">
			<p class="petitTitre petitTitreToiture">Nos interventions</p>
			<h2 class="titreInterventionsToiture">Un entretien complet de votre couverture</h2>
			<div class="grilleInterventionsToiture">
				{
					interventions.map(({ Icone, titre, description }) => (
						<div class="carteInterventionToiture reveal">
							<div class="iconeInterventionToiture"><Icone size={26} color="#ffffff" /></div>
							<p class="titreCarteToiture">{titre}</p>
							<p class="descCarteToiture">{description}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="sectionFaqToiture">
			<div class="faqToitureTexte">
				<p class="petitTitre">Questions fréquentes</p>
				<h2 class="titreFaqToiture">Vos questions sur l’entretien de toiture</h2>
			</div>
			<div class="faqToitureListe">
				{
					faqToiture.map(({ question, reponse, ouvert }) => (
						<details class="faqToitureItem" open={ouvert}>
							<summary class="questionFaqToiture">{question}</summary>
							<p class="reponseFaqToiture">{reponse}</p>
						</details>
					))
				}
			</div>
		</section>

		</div>
		<FaqSchema items={faqToiture} />
		<Footer></Footer>
	</main>
</Layout>
