---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import '../styles/global.css';
import '../styles/pages/qualifications.css';
import Navbar from '../components/Nav-Footer/Navbar.astro'
import Footer from '../components/Nav-Footer/Footer.astro'

import logoRge from '../assets/image/logo-rge.webp'
import logoCertibat from '../assets/image/logoCertibat.webp'
import garantieMipe from '../assets/image/garantieMipe.webp'
---

<Layout>

    <Navbar></Navbar>

    <div>
        <p class="petitTitre petitTitreQualification">Qualifications</p>
        <h1 class="titreQualification" >Nos certifications</h1>
        <p class="descQualification">MIPE Habitat dispose de qualifications professionnelles et de garanties à jour, adaptées à ses <br> différents métiers. Elles témoignent de notre savoir-faire et vous permettent de réaliser vos travaux <br> dans un cadre professionnel, sécurisé et conforme aux exigences de la rénovation énergétique.</p>
    </div>

    <div class="qualificationsContainer">
        <div class="qualificationCard">
            <Image class="imageQualif" src={logoRge} alt={'image du logo RGE'} width={80}/>
            <p class="titreQualifCard">RGE Qualibat</p>
            <p class="descQualif" >Des qualifications adaptées à nos métiers MIPE Habitat est qualifiée RGE Qualibat 7121, 7122 et 7131, attestant de nos compétences techniques pour la réalisation de différents travaux d’isolation et de rénovation énergétique.</p>
            <a class="voirCertif" href="/certificat/certificat-qualibat.pdf">Voir les certificats</a>
        </div>

        <div class="qualificationCard">
            <Image class="imageQualif" src={logoCertibat} alt={'image du logo RGE'} width={170}/>
            <p class="titreQualifCard">RGE Certibat</p>
            <p class="descQualif" >L’expertise de la rénovation énergétique globale Grâce à notre qualification Certibat, MIPE Habitat vous accompagne dans vos projets de rénovation énergétique globale, avec une approche complète et coordonnée des différents travaux de votre logement.</p>
            <a class="voirCertif" href="/certificat/certificat-rge-certibat.pdf" target="_blank">Voir le certificat</a>
        </div>

        <div class="qualificationCard">
            <Image class="imageQualif" src={garantieMipe} alt={'image du logo RGE'} width={120}/>
            <p class="titreQualifCard">Assurances & garanties</p>
            <p class="descQualif" >Des qualifications adaptées à nos métiers MIPE Habitat est qualifiée RGE Qualibat 7121, 7122 et 7131, attestant de nos compétences techniques pour la réalisation de différents travaux d’isolation et de rénovation énergétique.</p>
            <a class="voirCertif" href="/certificat/certificat-10ans.pdf" target="_blank">Voir le certificat</a>
        </div>
    </div>

    <Footer></Footer>


</Layout>
