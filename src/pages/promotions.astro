---
import '../styles/refonteAccueil.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FilAriane from '../components/FilAriane.astro';
import '../styles/global.css';
import '../styles/pages/promotions.css';
import { Check, Gift, CalendarClock, Phone } from '@lucide/astro';

---

<Layout title="Offres et promotions du moment | MIPE Habitat" description="Profitez des offres en cours sur vos travaux de rénovation avec MIPE Habitat : conditions et durée de validité détaillées pour chaque promotion.">
	<main>
		<Navbar></Navbar>
		<div class="refonte">
		<FilAriane items={[{ label: 'Promotions' }]} />

		<section class="enteteOffres">
			<p class="petitTitre">Promotions</p>
			<h1 class="titreOffres">Les offres du moment</h1>
			<p class="descOffres">Profitez des avantages réservés à nos clients sur vos travaux de rénovation. Chaque offre précise ses conditions et sa durée de validité.</p>
		</section>

		<section class="listeOffres" id="listeOffres" aria-live="polite"></section>

		<template id="promoIcones">
			<span data-i="gift"><Gift size={15} /></span>
			<span data-i="gift32"><Gift size={32} color="#6FBE2C" /></span>
			<span data-i="check"><Check size={16} color="#6FBE2C" /></span>
			<span data-i="calendrier"><CalendarClock size={16} /></span>
		</template>

		<div class="blocQuestionOffres">
		<section class="questionOffres">
			<div>
				<h2>Une question sur une offre ?</h2>
				<p>Un conseiller vous répond et étudie votre projet, sans engagement.</p>
			</div>
			<div class="actionsQuestionOffres">
				<a class="boutonOffre" href="/demander-un-devis"><CalendarClock size={16} />Prendre RDV</a>
				<a class="boutonOffre boutonOffreClair" href="tel:0375190160"><Phone size={16} />03 75 19 01 60</a>
			</div>
		</section>
		</div>

		</div>
		<Footer></Footer>
	</main>
</Layout>

<script src="../js/promotionsListe.js"></script>
