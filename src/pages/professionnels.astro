---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import '../styles/global.css';
import '../styles/pages/professionnels.css';
import { Check, ArrowRight, Phone, BuildingComplex, KeyRound, Users, HardHat } from '@lucide/astro';

const publics = [
	{ Icone: BuildingComplex, titre: 'Syndics de copropriété', description: "Travaux d'isolation, de ravalement ou de menuiseries pour vos parties communes et vos immeubles en copropriété." },
	{ Icone: KeyRound, titre: 'Agences immobilières', description: 'Valorisez les biens de votre portefeuille grâce à des travaux de rénovation énergétique ciblés.' },
	{ Icone: Users, titre: 'Bailleurs sociaux', description: 'Un accompagnement sur vos programmes de rénovation énergétique, à l’échelle de votre parc locatif.' },
	{ Icone: HardHat, titre: 'Promoteurs immobiliers', description: 'Un partenaire technique pour vos opérations de rénovation et de réhabilitation.' },
];

const etapes = [
	{ numero: '01', titre: 'Premier contact', description: 'Vous nous présentez votre projet ou votre parc immobilier, et nous échangeons sur vos besoins.' },
	{ numero: '02', titre: 'Étude technique', description: 'Nos équipes étudient le projet et vous proposent un devis détaillé, avec les aides mobilisables.' },
	{ numero: '03', titre: 'Réalisation et suivi', description: 'Nos équipes qualifiées réalisent les travaux, avec un suivi de chantier régulier jusqu’à la réception.' },
];
---

<Layout>
	<main>
		<Navbar></Navbar>

		<section class="heroPro reveal">
			<div class="heroProContenu">
				<p class="petitTitre">Professionnels</p>
				<h1 class="titrePro">Un partenaire de confiance pour vos projets de rénovation énergétique</h1>
				<p class="descPro">Syndic de copropriété, agence immobilière, bailleur social ou promoteur : MIPE Habitat accompagne les professionnels de l’immobilier dans leurs projets de rénovation énergétique, avec un interlocuteur dédié du premier contact jusqu’à la réception des travaux.</p>
				<div class="ctaPro">
					<a href="/demander-un-devis" class="boutonPro boutonProPlein">Nous contacter <ArrowRight size={16} /></a>
					<a href="tel:0375190160" class="boutonPro boutonProContour"><Phone size={16} /> 03 75 19 01 60</a>
				</div>
			</div>
		</section>

		<section class="sectionPublicsPro reveal">
			<p class="petitTitre">Vous êtes</p>
			<h2 class="titreSectionPro">Un professionnel de l’immobilier ?</h2>
			<div class="grillePublicsPro">
				{
					publics.map(({ Icone, titre, description }) => (
						<div class="cartePublicPro reveal">
							<div class="iconePublicPro"><Icone size={22} color="#6FBE2C" /></div>
							<p class="titreCartePro">{titre}</p>
							<p class="descCartePro">{description}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="sectionAtoutsPro reveal">
			<div class="texteAtoutsPro">
				<p class="petitTitre">Pourquoi MIPE Habitat</p>
				<h2 class="titreSectionPro">Un savoir-faire reconnu, une relation de confiance</h2>
				<div class="checkContainer">
					<p class="check"><Check size={15} color="#8FE05C" />Certifiés RGE Qualibat pour nos travaux d’isolation</p>
					<p class="check"><Check size={15} color="#8FE05C" />Une entreprise basée dans l’Oise depuis 2011</p>
					<p class="check"><Check size={15} color="#8FE05C" />Intervention dans l’Oise et en Île-de-France</p>
					<p class="check"><Check size={15} color="#8FE05C" />Un interlocuteur dédié pour le suivi de vos projets</p>
					<p class="check"><Check size={15} color="#8FE05C" />Accompagnement dans les démarches d’aides pour vos clients</p>
				</div>
			</div>
		</section>

		<section class="sectionEtapesPro reveal">
			<p class="petitTitre">Notre accompagnement</p>
			<h2 class="titreSectionPro">Comment ça marche</h2>
			<div class="grilleEtapesPro">
				{
					etapes.map(({ numero, titre, description }) => (
						<div class="carteEtapePro reveal">
							<p class="numeroEtapePro">{numero}</p>
							<p class="titreEtapePro">{titre}</p>
							<p class="descEtapePro">{description}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="ctaFinalePro reveal">
			<h2>Un projet pour votre copropriété ou votre parc immobilier ?</h2>
			<p>Contactez notre équipe pour échanger sur votre projet.</p>
			<div class="ctaFinaleProBoutons">
				<a href="/demander-un-devis" class="boutonPro boutonProPlein">Demander un devis <ArrowRight size={16} /></a>
				<a href="tel:0375190160" class="boutonPro boutonProContourBlanc"><Phone size={16} /> 03 75 19 01 60</a>
			</div>
		</section>

		<Footer></Footer>
	</main>
</Layout>
