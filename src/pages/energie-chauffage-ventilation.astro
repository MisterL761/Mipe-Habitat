---
import BoutonRdv from '../components/BoutonRdv.astro';
import '../styles/refonteAccueil.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FaqSchema from '../components/FaqSchema.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import FilAriane from '../components/FilAriane.astro';
import '../styles/global.css';
import '../styles/pages/energie-chauffage-ventilation.css';
import { Check, Flame, Snowflake, ShieldCheck } from '@lucide/astro';
import { Image } from 'astro:assets';

import photoClim from '../assets/image/pompeChaleur.webp';

const solutions = [
	{
		Icone: Flame,
		titre: 'Chauffage',
		points: [
			'Pompes à chaleur air/air, air/eau et eau/eau',
			'Chaudières gaz à condensation',
			'Marques installées : Saunier Duval, e.l.m. leblanc, De Dietrich',
		],
	},
	{
		Icone: Snowflake,
		titre: 'Climatisation',
		points: [
			'Systèmes mono-split et multi-split',
			'Climatisation gainable et cassettes',
			'Solutions réversibles (chaud/froid)',
		],
	},
];

const certifications = ['RGE', 'QualiPAC', 'Chauffage +', 'Qualigaz', 'SOCOTEC'];

const faqEnergie = [
	{ question: "Quelle solution de chauffage ou de climatisation choisir pour votre maison ?", reponse: ["Pompe à chaleur air/eau, climatisation réversible ou autre solution de chauffage : le choix dépend de votre habitation, de son isolation, de vos équipements existants et de vos besoins. MIPE Habitat vous accompagne dans l'étude de votre projet afin de vous orienter vers une solution adaptée à votre confort et à votre budget."], ouvert: true },
	{ question: "Comment être sûr que votre pompe à chaleur est correctement dimensionnée ?", reponse: [
		"Une pompe à chaleur doit être adaptée aux besoins réels de votre habitation. Un équipement sous-dimensionné risque de ne pas assurer un chauffage suffisant, tandis qu'un équipement surdimensionné peut entraîner des cycles de fonctionnement trop courts, une usure prématurée et une consommation inutile.",
		"Chez MIPE Habitat, nous utilisons le logiciel professionnel CardoPAC pour réaliser une étude de dimensionnement, en nous appuyant sur les caractéristiques du logement, son isolation et ses déperditions thermiques.",
		"Cette étude permet d'établir une note de calcul conforme à la méthode de la norme NF EN 12831, afin de déterminer les besoins de chauffage et d'orienter le choix de la puissance de la pompe à chaleur.",
		"Notre objectif : vous proposer un équipement adapté à votre maison, sans surdimensionnement inutile, pour un confort optimal et une consommation maîtrisée.",
	], ouvert: false },
	{ question: "Qui réalise l'installation des équipements ?", reponse: ["MIPE Habitat s'appuie sur des entreprises partenaires spécialisées et disposant des qualifications requises pour les travaux réalisés. Nous vous accompagnons dans votre projet et facilitons la coordination des différentes interventions, notamment lorsque le chauffage s'intègre à des travaux d'isolation ou à une rénovation énergétique plus globale."], ouvert: false },
	{ question: "Quelles aides financières pour installer une pompe à chaleur ?", reponse: ["Selon le type de pompe à chaleur, votre logement et votre situation, vous pouvez bénéficier de dispositifs comme MaPrimeRénov' ou les Certificats d'Économies d'Énergie (CEE). Les conditions et montants varient selon les équipements et la réglementation en vigueur. Nous vous orientons vers les dispositifs susceptibles de correspondre à votre projet."], ouvert: false },
	{ question: "Peut-on associer une pompe à chaleur à des travaux d'isolation ?", reponse: ["Oui, et c'est même souvent recommandé ! Améliorer l'isolation de votre maison avant de remplacer votre chauffage permet de réduire les besoins énergétiques et de mieux dimensionner votre futur équipement. MIPE Habitat peut vous accompagner dans cette approche globale, en associant ses travaux d'isolation aux solutions de chauffage proposées par ses partenaires."], ouvert: false },
];
---

<Layout title="Pompe à chaleur, chauffage et climatisation | MIPE Habitat" description="Pompes à chaleur, climatisation réversible et ventilation : MIPE Habitat coordonne étude, devis, installation et suivi dans l'Oise et en Île-de-France.">
	<main>
		<Navbar></Navbar>
		<div class="refonte">
		<FilAriane items={[{ label: 'Nos métiers', href: '/nos-metiers' }, { label: 'Énergie, chauffage & ventilation' }]} />

		<section class="containerImageDroite">
			<div class="containerParentImageDroite">
				<div class="textImageDroite">
					<p class="petitTitre">Énergie, chauffage & ventilation</p>
					<h1 class="titreImage">Des solutions de chauffage et de climatisation performantes</h1>
					<p class="descImage">Pompes à chaleur, chaudières, climatisation réversible : MIPE Habitat vous propose des solutions énergétiques adaptées à votre logement, avec des installateurs qualifiés et un seul interlocuteur.</p>
					<p class="check"><Check size={15} color="#8FE05C" />Pompes à chaleur air/air, air/eau et eau/eau</p>
					<p class="check"><Check size={15} color="#8FE05C" />Chaudières gaz et climatisation réversible</p>
					<p class="check"><Check size={15} color="#8FE05C" />Installation par des professionnels certifiés RGE</p>
				</div>
				<div class="imageDroite">
					<Image src={photoClim} alt="Installation de climatisation / pompe à chaleur" />
				</div>
			</div>
		</section>

		<section class="sectionSolutionsEnergie reveal">
			<p class="petitTitre petitTitreEnergie">Nos solutions</p>
			<h2 class="titreSolutionsEnergie">Chauffage et climatisation, une offre complète</h2>
			<div class="grilleSolutionsEnergie">
				{
					solutions.map(({ Icone, titre, points }) => (
						<div class="carteSolutionEnergie reveal">
							<div class="iconeSolutionEnergie"><Icone size={26} color="#ffffff" /></div>
							<p class="titreCarteEnergie">{titre}</p>
							<ul class="listePointsEnergie">
								{points.map((point) => (
									<li>
										<Check size={15} color="#8FE05C" />
										<span>{point}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="sectionPartenaireEnergie reveal">
			<div class="containerPartenaireEnergie">
				<div class="texteePartenaireEnergie">
					<p class="petitTitre">Installation</p>
					<h2 class="titrePartenaireEnergie">Des installations réalisées par des professionnels certifiés</h2>
					<p class="descPartenaireEnergie">MIPE Habitat coordonne votre projet de chauffage et de climatisation : étude, devis, installation et suivi. Les équipements sont posés par des professionnels qualifiés, avec un interlocuteur unique pour toutes vos questions.</p>
					<div class="listeCertifEnergie">
						{
							certifications.map((certif) => (
								<span class="badgeCertifEnergie"><ShieldCheck size={14} color="#6FBE2C" />{certif}</span>
							))
						}
					</div>
					<BoutonRdv />
				</div>
			</div>
		</section>

		<section class="sectionFaqEnergie">
			<div class="faqEnergieTexte">
				<p class="petitTitre">Questions fréquentes</p>
				<h2 class="titreFaqEnergie">Vos questions sur le chauffage et la climatisation</h2>
			</div>
			<div class="faqEnergieListe">
				{
					faqEnergie.map(({ question, reponse, ouvert }) => (
						<details class="faqEnergieItem" open={ouvert}>
							<summary class="questionFaqEnergie">{question}</summary>
							{reponse.map((paragraphe) => <p class="reponseFaqEnergie">{paragraphe}</p>)}
						</details>
					))
				}
			</div>
		</section>

		</div>
		<FaqSchema items={faqEnergie} />
		<ServiceSchema nom="Pompe à chaleur, chauffage et climatisation" />
		<Footer></Footer>
	</main>
</Layout>

