---
import '../styles/refonteAccueil.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FilAriane from '../components/FilAriane.astro';
import '../styles/global.css';
import '../styles/pages/energie-chauffage-ventilation.css';
import { Check, Flame, Snowflake, ShieldCheck } from '@lucide/astro';
import { Image } from 'astro:assets';

import photoClim from '../assets/image/pompe.jpeg';

const solutions = [
	{
		Icone: Flame,
		titre: 'Chauffage',
		points: [
			'Pompes à chaleur air/air, air/eau et eau/eau',
			'Chaudières gaz à condensation',
			'Marques installées : Saunier Duval, e.l.m. leblanc, De Dietrich',
		],
	},
	{
		Icone: Snowflake,
		titre: 'Climatisation',
		points: [
			'Systèmes mono-split et multi-split',
			'Climatisation gainable et cassettes',
			'Solutions réversibles (chaud/froid)',
		],
	},
];

const certifications = ['RGE', 'QualiPAC', 'Chauffage +', 'Qualigaz', 'SOCOTEC'];

const faqEnergie = [
	{ question: 'Qui installe les équipements de chauffage et de climatisation ?', reponse: "L'installation est assurée par des professionnels qualifiés et certifiés RGE, sous la coordination de MIPE Habitat, votre interlocuteur unique du début à la fin du projet.", ouvert: true },
	{ question: 'Une pompe à chaleur est-elle éligible aux aides ?', reponse: "Selon votre projet et votre éligibilité, le remplacement d'un système de chauffage par une pompe à chaleur peut être concerné par certaines aides (MaPrimeRénov', CEE...). Nos équipes étudient votre situation pour vous orienter.", ouvert: false },
	{ question: 'Quelle différence entre une PAC air/air et air/eau ?', reponse: "Une PAC air/air diffuse de l'air chaud ou froid directement dans les pièces (idéale en climatisation réversible). Une PAC air/eau alimente un circuit de chauffage central (radiateurs, plancher chauffant) et peut aussi produire l'eau chaude sanitaire.", ouvert: false },
	{ question: 'Le devis est-il gratuit ?', reponse: 'Oui. Après un premier échange sur votre projet, un conseiller étudie vos besoins et vous propose un devis gratuit et sans engagement.', ouvert: false },
];
---

<Layout>
	<main>
		<Navbar></Navbar>
		<div class="refonte">
		<FilAriane items={[{ label: 'Nos métiers', href: '/nos-metiers' }, { label: 'Énergie, chauffage & ventilation' }]} />

		<section class="containerImageDroite">
			<div class="containerParentImageDroite">
				<div class="textImageDroite">
					<p class="petitTitre">Énergie, chauffage & ventilation</p>
					<h1 class="titreImage">Des solutions de chauffage et de climatisation performantes</h1>
					<p class="descImage">Pompes à chaleur, chaudières, climatisation réversible : MIPE Habitat vous propose des solutions énergétiques adaptées à votre logement, avec des installateurs qualifiés et un seul interlocuteur.</p>
					<p class="check"><Check size={15} color="#8FE05C" />Pompes à chaleur air/air, air/eau et eau/eau</p>
					<p class="check"><Check size={15} color="#8FE05C" />Chaudières gaz et climatisation réversible</p>
					<p class="check"><Check size={15} color="#8FE05C" />Installation par des professionnels certifiés RGE</p>
				</div>
				<div class="imageDroite">
					<Image src={photoClim} alt="Installation de climatisation / pompe à chaleur" />
				</div>
			</div>
		</section>

		<section class="sectionSolutionsEnergie reveal">
			<p class="petitTitre petitTitreEnergie">Nos solutions</p>
			<h2 class="titreSolutionsEnergie">Chauffage et climatisation, une offre complète</h2>
			<div class="grilleSolutionsEnergie">
				{
					solutions.map(({ Icone, titre, points }) => (
						<div class="carteSolutionEnergie reveal">
							<div class="iconeSolutionEnergie"><Icone size={26} color="#ffffff" /></div>
							<p class="titreCarteEnergie">{titre}</p>
							<ul class="listePointsEnergie">
								{points.map((point) => (
									<li>
										<Check size={15} color="#8FE05C" />
										<span>{point}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="sectionPartenaireEnergie reveal">
			<div class="containerPartenaireEnergie">
				<div class="texteePartenaireEnergie">
					<p class="petitTitre">Installation</p>
					<h2 class="titrePartenaireEnergie">Des installations réalisées par des professionnels certifiés</h2>
					<p class="descPartenaireEnergie">MIPE Habitat coordonne votre projet de chauffage et de climatisation : étude, devis, installation et suivi. Les équipements sont posés par des professionnels qualifiés, avec un interlocuteur unique pour toutes vos questions.</p>
					<div class="listeCertifEnergie">
						{
							certifications.map((certif) => (
								<span class="badgeCertifEnergie"><ShieldCheck size={14} color="#6FBE2C" />{certif}</span>
							))
						}
					</div>
					<a href="/demander-un-devis" class="lienPartenaireEnergie">Demander un devis gratuit</a>
				</div>
			</div>
		</section>

		<section class="sectionFaqEnergie">
			<div class="faqEnergieTexte">
				<p class="petitTitre">Questions fréquentes</p>
				<h2 class="titreFaqEnergie">Vos questions sur le chauffage et la climatisation</h2>
			</div>
			<div class="faqEnergieListe">
				{
					faqEnergie.map(({ question, reponse, ouvert }) => (
						<details class="faqEnergieItem" open={ouvert}>
							<summary class="questionFaqEnergie">{question}</summary>
							<p class="reponseFaqEnergie">{reponse}</p>
						</details>
					))
				}
			</div>
		</section>

		</div>
		<Footer></Footer>
	</main>
</Layout>

