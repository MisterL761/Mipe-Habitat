---
import '../styles/refonteAccueil.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FilAriane from '../components/FilAriane.astro';
import { ArrowRight } from '@lucide/astro';
import '../styles/global.css';
import '../styles/pages/nos-secteurs-intervention.css';
import { villes } from './renovation-energetique/[ville].astro';

const villesPlessis = villes.filter((v) => v.agence === 'plessis');
const villesPlaisir = villes.filter((v) => v.agence === 'plaisir');
---

<Layout title="Nos secteurs d'intervention | MIPE Habitat" description="MIPE Habitat intervient dans l'Oise, la Seine-et-Marne, l'Aisne, la Seine-Saint-Denis, les Yvelines, les Hauts-de-Seine, le Val-de-Marne et le Val-d'Oise. Retrouvez votre ville.">
	<main>
		<Navbar></Navbar>
		<div class="refonte">
		<FilAriane items={[{ label: "Nos secteurs d'intervention" }]} />

		<section class="sectionSecteurs">
			<div class="heroSecteurs">
				<p class="petitTitre">Zone d'intervention</p>
				<h1 class="titreSecteurs">Nos secteurs d'intervention</h1>
				<p class="descSecteurs">MIPE Habitat intervient dans l'Oise, la Seine-et-Marne, l'Aisne et la Seine-Saint-Denis depuis son agence du Plessis-Belleville, ainsi que dans les Yvelines, les Hauts-de-Seine, le Val-de-Marne et le Val-d'Oise depuis son implantation de Plaisir. Retrouvez votre ville ci-dessous.</p>
			</div>

			<div class="groupeSecteurs">
				<h2 class="titreGroupeSecteurs">Depuis l'agence du Plessis-Belleville</h2>
				<div class="grilleSecteurs">
					{
						villesPlessis.map(({ nom, slug, cp }) => (
							<a href={`/renovation-energetique/${slug}`} class="carteSecteur">
								<span class="nomSecteur">{nom}</span>
								<span class="cpSecteur">{cp}</span>
							</a>
						))
					}
				</div>
			</div>

			<div class="groupeSecteurs">
				<h2 class="titreGroupeSecteurs">Depuis l'agence de Plaisir</h2>
				<div class="grilleSecteurs">
					{
						villesPlaisir.map(({ nom, slug, cp }) => (
							<a href={`/renovation-energetique/${slug}`} class="carteSecteur">
								<span class="nomSecteur">{nom}</span>
								<span class="cpSecteur">{cp}</span>
							</a>
						))
					}
				</div>
			</div>

			<div class="sectionCtaSecteurs">
				<h2>Votre ville n'apparaît pas dans la liste ?</h2>
				<p>Contactez-nous : nous intervenons dans tout le secteur autour de nos deux agences.</p>
				<a href="/demander-un-devis" class="btnDevisSecteurs">Demander un devis gratuit <ArrowRight size={16} /></a>
			</div>
		</section>

		</div>
		<Footer></Footer>
	</main>
</Layout>
