---
import '../styles/refonteAccueil.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Fournisseurs from '../components/Fournisseurs.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FaqSchema from '../components/FaqSchema.astro';
import FilAriane from '../components/FilAriane.astro';
import '../styles/global.css';
import '../styles/pages/menuiseries.css';
import { Check, Factory, MapPin } from '@lucide/astro';
import { Image } from 'astro:assets';

import menuiserie from '../assets/image/menuiserie.webp';
import analyse from '../assets/image/analyseDepFenetre.webp'
import pe from '../assets/image/pe.webp';
import voletRoulant from '../assets/image/voletR.webp'
import logoIsofrance from '../assets/image/logo-isofrance.webp';

const autresMenuiseries = [
    'Portes de garage', 'Portes d\'intérieur', 'Pergolas', 'Vérandas',
    'Portails, clôtures et portillons', 'Garde-corps', 'Stores intérieurs',
    'Stores extérieurs', 'Moustiquaires', 'Grilles de défense', 'Motorisation',
];

const faqMenuiseries = [
	{ question: "Quelles aides pour remplacer ses anciennes fenêtres ?", reponse: "Le remplacement de fenêtres anciennes peut, sous certaines conditions, bénéficier d'aides financières, notamment des Certificats d'Économies d'Énergie (CEE). Les menuiseries peuvent également être intégrées à un projet de rénovation énergétique d'ampleur. MIPE Habitat vous informe sur les dispositifs applicables à votre projet et les conditions d'éligibilité.", ouvert: true },
	{ question: "Quel matériau choisir pour ses fenêtres : PVC, aluminium ou bois ?", reponse: "Chaque matériau présente ses avantages. Le PVC offre un excellent rapport qualité-prix et nécessite peu d'entretien. L'aluminium séduit par son esthétique moderne et ses profilés fins. Le bois apporte un caractère authentique et une excellente isolation. Les menuiseries mixtes bois-aluminium associent également esthétique et durabilité. Nos conseillers vous orientent vers la solution adaptée à votre habitation, à vos envies et à votre budget.", ouvert: false },
	{ question: "Peut-on remplacer ses fenêtres sans réaliser d'autres travaux ?", reponse: "Oui, il est tout à fait possible de remplacer uniquement vos fenêtres ou vos portes. Selon l'état des menuiseries existantes, une pose en rénovation ou une dépose totale peut être envisagée. Nos équipes étudient la solution la mieux adaptée pour améliorer votre confort thermique et acoustique, tout en préservant l'esthétique de votre habitation.", ouvert: false },
	{ question: "Faut-il une autorisation pour changer ses fenêtres, portes ou volets ?", reponse: "Un remplacement à l'identique ne nécessite généralement pas d'autorisation particulière. En revanche, si vous modifiez l'aspect extérieur de votre habitation (couleur, dimensions ou modèle), une déclaration préalable de travaux peut être nécessaire. Des règles spécifiques peuvent également s'appliquer en copropriété ou en secteur protégé.", ouvert: false },
	{ question: "Comment se déroule un projet de remplacement de menuiseries avec MIPE Habitat ?", reponse: "Nous vous accompagnons de l'étude de votre projet jusqu'à la pose de vos nouvelles menuiseries. Après une visite à domicile et un devis gratuit, nous vous conseillons sur les matériaux, les performances et les finitions. Une prise de mesures précise est ensuite réalisée avant la commande et l'installation, pour une pose soignée et adaptée à votre habitation.", ouvert: false },
];

const atout = [
    {titre : 'Performance thermique', description : 'Des vitrages et profilés performants pour limiter les déperditions et améliorer le confort intérieur.'},
    {titre : 'Performance thermique', description : 'Des vitrages et profilés performants pour limiter les déperditions et améliorer le confort intérieur.'},
    {titre : 'Performance thermique', description : 'Des vitrages et profilés performants pour limiter les déperditions et améliorer le confort intérieur.'},
    {titre : 'Performance thermique', description : 'Des vitrages et profilés performants pour limiter les déperditions et améliorer le confort intérieur.'},
];
---

<Layout
	title="Menuiseries Isofrance : fenêtres, portes et baies vitrées | MIPE Habitat"
	description="Fenêtres, portes-fenêtres, baies vitrées et portes d'entrée Isofrance, fabriquées en France à Châteauroux et La Bresse, posées par MIPE Habitat dans l'Oise et en Île-de-France."
>

    <main>
        <Navbar></Navbar>
        <div class="refonte">
        <FilAriane items={[{ label: 'Nos métiers', href: '/nos-metiers' }, { label: 'Menuiseries extérieures' }]} />
        <section class="containerImageDroite">

            <br>
            <br>

            <div class="containerParentImageDroite">
                <div class="textImageDroite">
                    <p class="petitTitre">Menuiseries</p>
                    <h1 class="titreImage">Des menuiseries performantes pour un logement mieux isolé</h1>
                    <p class="descImage">Des menuiseries performantes pour améliorer votre confort fenêtres, portes-fenêtres, baies vitrées et portes d’entrée participent pleinement au confort thermique et acoustique de votre logement. Remplacer des menuiseries anciennes permet de limiter les déperditions et les infiltrations d’air tout en modernisant votre habitation.</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Amélioration de l’isolation thermique et acoustique</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Menuiseries sur mesure adaptées à votre habitation</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Un large choix de matériaux, finitions et équipements</p>
                </div>
                <div class="imageDroite">

                    <Image src={menuiserie} alt="image d'une facade avec des menuiseries neuve"/>

                </div>
            </div>
        </section>

        <section class="containerAtout">
            <div class="containerCardAtout">
                {
                    atout.map(({ titre, description }) => (
                            <div class="cardAtout">
                                <p class="titreAtout">{titre}</p>
                                <p class="descriptionAtout">{description}</p>
                            </div>
                    ))
                }
            </div>
        </section>

        <section class="containerImageGauche">

            <div class="containerParentImageGauche">
                <div class="imageGauche">
                    <Image src={analyse} alt="image d'une facade avec des menuiseries neuve"/>
                </div>
                <div class="textImageGauche">

                    <p class="petitTitre">Fenêtres</p>
                    <h2 class="titreImage">Des fenêtres performantes, été comme hiver</h2>
                    <p class="descImage">Le remplacement de fenêtres anciennes permet de limiter les déperditions, les infiltrations d’air et l’effet de paroi froide. Le choix du vitrage et de la menuiserie est étudié selon les caractéristiques de votre logement.</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Double ou triple vitrage selon les besoins</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>PVC, aluminium ou autres solutions selon le projet</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Fenêtres, portes-fenêtres et baies vitrées sur mesure</p>

                </div>
            </div>

        </section>

        <section class="sectionIsofrance reveal">
            <div class="containerIsofrance">
                <div class="logoIsofranceWrapper">
                    <Image src={logoIsofrance} alt="Logo Isofrance, Fenêtres & Energies" />
                </div>
                <div class="texteIsofrance">
                    <p class="petitTitre">Notre partenaire menuiseries</p>
                    <h2 class="titreImage">Des menuiseries Isofrance</h2>
                    <p class="descImage">Pour vos fenêtres, portes-fenêtres et baies vitrées, nous travaillons avec Isofrance, spécialiste des solutions fenêtres & énergies. Leurs menuiseries existent en PVC et en aluminium. Une collaboration qui garantit des menuiseries performantes, isolantes et durables.</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Produits sélectionnés pour leur performance thermique</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Pose assurée par nos équipes qualifiées</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Garanties fabricant sur vos menuiseries</p>
                </div>
            </div>

            <div class="blocUsineFrance">
                <div class="badgeUsineFrance">
                    <span class="drapeauFrance" aria-hidden="true"></span>
                    Usine en France
                </div>
                <p class="introUsineFrance">Les menuiseries Isofrance sont fabriquées en France, au sein du groupe AT Partner, dans deux usines dédiées :</p>
                <div class="grilleUsines">
                    <div class="carteUsine">
                        <div class="iconeUsine"><Factory size={20} color="#ffffff" /></div>
                        <p class="villeUsine"><MapPin size={14} color="#6FBE2C" />Châteauroux (Indre) · PVC</p>
                        <p class="descUsine">Site historique fondé en 1947, dédié aux menuiseries PVC : fenêtres, portes-fenêtres et portes d'entrée sur mesure. L'usine fait l'objet d'un plan de modernisation de plusieurs millions d'euros pour accroître ses cadences.</p>
                    </div>
                    <div class="carteUsine">
                        <div class="iconeUsine"><Factory size={20} color="#ffffff" /></div>
                        <p class="villeUsine"><MapPin size={14} color="#6FBE2C" />La Bresse (Vosges) · Aluminium</p>
                        <p class="descUsine">Site SNM, entièrement dédié aux menuiseries aluminium, sous les marques AMCC, AMGO et Closy.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="containerImageDroite">

            <div class="containerParentImageDroite">
                <div class="textImageDroite">
                    <p class="petitTitre">Portes d'entrée</p>
                    <h2 class="titreImage">Isolation, sécurité et esthétique dès l’entrée</h2>
                    <p class="descImage">Une porte d’entrée performante contribue à limiter les infiltrations d’air et les déperditions tout en renforçant la sécurité et l’esthétique de votre habitation. Le coefficient Ud mesure la quantité de chaleur qui traverse une porte : plus il est faible, meilleure est son isolation thermique.</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Performances thermiques adaptées au logement</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Systèmes de fermeture multipoints</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Large choix de modèles, matériaux et coloris</p>
                </div>
                <div class="imageDroite">

                    <Image src={pe} alt="image d'une facade avec des menuiseries neuve"/>

                </div>
            </div>
        </section>

        <section class="containerImageGauche">

            <div class="containerParentImageGauche">
                <div class="imageGauche">
                    <Image src={voletRoulant} alt="image d'une facade avec des menuiseries neuve"/>
                </div>
                <div class="textImageGauche">

                    <p class="petitTitre">VOLETS & FERMETURES</p>
                    <h2 class="titreImage">Confort, protection et maîtrise de la lumière</h2>
                    <p class="descImage">Volets roulants ou battants : les fermetures complètent vos menuiseries pour améliorer le confort, l’occultation et la protection de votre habitation.</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Volets roulants électriques ou motorisés</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Solutions adaptées en rénovation</p>
                    <p class="check"><Check size={15} color="#8FE05C"/>Large choix de finitions et de coloris</p>

                </div>
            </div>

        </section>

        <section class="sectionAutresMenuiseries">
            <p class="petitTitre">NOS AUTRES MENUISERIES ET ÉQUIPEMENTS</p>
            <h2 class="titreAutresMenuiseries">Des solutions pour tous vos projets d'aménagement</h2>
            <p class="descAutresMenuiseries">Au-delà des fenêtres, portes d'entrée et volets, MIPE Habitat vous accompagne dans l'amélioration et l'aménagement de votre habitation. Sécurité, confort, esthétique ou aménagement extérieur : découvrez nos solutions sur mesure, adaptées à vos besoins et à vos envies.</p>
            <div class="listeAutresMenuiseries">
                {
                    autresMenuiseries.map((nom) => (
                        <span class="badgeAutreMenuiserie">{nom}</span>
                    ))
                }
            </div>
        </section>

        <Fournisseurs categorie="Menuiseries" />

        <section class="sectionFaqMenuiseries">
            <div class="faqMenuiseriesTexte">
                <p class="petitTitre">Questions fréquentes</p>
                <h2 class="titreFaqMenuiseries">Vos questions sur nos fenêtres, portes et volets</h2>
            </div>
            <div class="faqMenuiseriesListe">
                {
                    faqMenuiseries.map(({ question, reponse, ouvert }) => (
                        <details class="faqMenuiseriesItem" open={ouvert}>
                            <summary class="questionFaqMenuiseries">{question}</summary>
                            <p class="reponseFaqMenuiseries">{reponse}</p>
                        </details>
                    ))
                }
            </div>
        </section>
        </div>
        <FaqSchema items={faqMenuiseries} />
        <Footer></Footer>
    </main>
</Layout>








