---
import '../styles/refonteAccueil.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FaqSchema from '../components/FaqSchema.astro';
import FilAriane from '../components/FilAriane.astro';
import '../styles/global.css';
import '../styles/pages/velux.css';
import { Check, Sun, Wrench, ShieldCheck } from '@lucide/astro';
import { Image } from 'astro:assets';

import photoVelux from '../assets/image/velux.webp';

const interventions = [
	{
		Icone: Sun,
		titre: 'Pose de fenêtres de toit VELUX',
		description: "Création d'ouvertures et installation de fenêtres de toit adaptées à votre charpente et à votre couverture. Apportez lumière naturelle, ventilation et confort à vos combles.",
	},
	{
		Icone: Wrench,
		titre: 'Remplacement de fenêtres VELUX',
		description: "Modernisez vos anciennes fenêtres de toit avec des modèles plus performants, offrant une meilleure isolation thermique, un confort d'utilisation accru et de nouvelles fonctionnalités.",
	},
	{
		Icone: ShieldCheck,
		titre: 'Étanchéité et finitions intérieures',
		description: "Raccordement à la couverture, traitement de l'étanchéité, isolation périphérique et habillage intérieur : nous apportons un soin particulier aux finitions pour une installation durable et esthétique.",
	},
];

const faqVelux = [
	{ question: 'Pourquoi installer une fenêtre de toit VELUX ?', reponse: "Une fenêtre de toit permet de faire entrer davantage de lumière naturelle et de ventiler efficacement vos combles. Elle transforme un espace sombre en une pièce plus agréable à vivre et contribue au confort de votre habitation, notamment grâce aux vitrages isolants et aux équipements de protection solaire.", ouvert: true },
	{ question: 'Peut-on installer un VELUX dans des combles non aménagés ?', reponse: "Oui, l'installation d'une fenêtre de toit peut s'intégrer à un futur projet d'aménagement des combles. Elle permet d'anticiper les besoins en lumière naturelle et en ventilation. Nos équipes étudient la configuration de votre charpente, la pente de toiture et les contraintes techniques pour définir la solution adaptée.", ouvert: false },
	{ question: 'Faut-il une autorisation pour installer une fenêtre de toit ?', reponse: "Oui, la création d'une fenêtre de toit nécessite généralement une déclaration préalable de travaux en mairie, puisqu'elle modifie l'aspect extérieur du bâtiment. Des règles particulières peuvent s'appliquer en secteur protégé ou en copropriété. Nous vous informons des démarches à prévoir avant les travaux.", ouvert: false },
	{ question: 'Peut-on remplacer un ancien VELUX sans modifier la toiture ?', reponse: "Oui, dans de nombreux cas, un ancien VELUX peut être remplacé par un modèle plus récent, en conservant les dimensions de l'ouverture existante. Cette intervention permet d'améliorer l'isolation thermique, l'étanchéité et le confort d'utilisation, sous réserve de compatibilité avec la couverture et le chevêtre existant.", ouvert: false },
	{ question: 'Le déplacement et le devis sont-ils gratuits ?', reponse: 'Oui, nos devis sont gratuits et sans engagement. Après un premier échange, un conseiller MIPE Habitat peut se déplacer pour étudier votre toiture, prendre les mesures nécessaires et vous proposer une fenêtre de toit adaptée à votre projet.', ouvert: false },
];
---

<Layout title="Pose et remplacement de fenêtres de toit | MIPE Habitat" description="Pose et remplacement de fenêtres de toit : lumière naturelle, ventilation et installation parfaitement étanche pour vos combles. MIPE Habitat.">
	<main>
		<Navbar></Navbar>
		<div class="refonte">
		<FilAriane items={[{ label: 'Nos métiers', href: '/nos-metiers' }, { label: 'Fenêtres de toit' }]} />

		<section class="containerImageDroite">
			<div class="containerParentImageDroite">
				<div class="textImageDroite">
					<p class="petitTitre">Fenêtres de toit</p>
					<h1 class="titreImage">Faites entrer la lumière naturelle dans vos combles avec une fenêtre de toit</h1>
					<p class="descImage">Pose et remplacement de fenêtres de toit : MIPE Habitat vous accompagne pour éclairer, ventiler et valoriser vos combles, avec une installation soignée et parfaitement étanche.</p>
					<p class="check"><Check size={15} color="#8FE05C" />Pose et remplacement de fenêtres de toit</p>
					<p class="check"><Check size={15} color="#8FE05C" />Étanchéité et finitions soignées</p>
					<p class="check"><Check size={15} color="#8FE05C" />Plus de lumière et de confort dans vos combles</p>
				</div>
				<div class="imageDroite">
					<Image src={photoVelux} alt="Fenêtre de toit posée par MIPE Habitat" />
				</div>
			</div>
		</section>

		<section class="sectionInterventionsVelux reveal">
			<p class="petitTitre petitTitreVelux">Nos interventions</p>
			<h2 class="titreInterventionsVelux">Une pose de fenêtre de toit complète, de l'étude aux finitions</h2>
			<div class="grilleInterventionsVelux">
				{
					interventions.map(({ Icone, titre, description }) => (
						<div class="carteInterventionVelux reveal">
							<div class="iconeInterventionVelux"><Icone size={26} color="#ffffff" /></div>
							<p class="titreCarteVelux">{titre}</p>
							<p class="descCarteVelux">{description}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="sectionFaqVelux">
			<div class="faqVeluxTexte">
				<p class="petitTitre">Questions fréquentes</p>
				<h2 class="titreFaqVelux">Vos questions sur les fenêtres de toit</h2>
			</div>
			<div class="faqVeluxListe">
				{
					faqVelux.map(({ question, reponse, ouvert }) => (
						<details class="faqVeluxItem" open={ouvert}>
							<summary class="questionFaqVelux">{question}</summary>
							<p class="reponseFaqVelux">{reponse}</p>
						</details>
					))
				}
			</div>
		</section>

		</div>
		<FaqSchema items={faqVelux} />
		<Footer></Footer>
	</main>
</Layout>
