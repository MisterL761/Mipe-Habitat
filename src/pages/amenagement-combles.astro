---
import '../styles/refonteAccueil.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Nav-Footer/Navbar.astro';
import Footer from '../components/Nav-Footer/Footer.astro';
import FaqSchema from '../components/FaqSchema.astro';
import FilAriane from '../components/FilAriane.astro';
import '../styles/global.css';
import '../styles/pages/amenagement-combles.css';
import { Check, Ruler, Layers, Sun } from '@lucide/astro';
import { Image } from 'astro:assets';

import photoCombles from '../assets/image/amenagement-comble.webp';

const interventions = [
	{
		Icone: Ruler,
		titre: 'Étude et conseils',
		description: 'Nous étudions la configuration de vos combles déjà aménageables afin de vous proposer des solutions adaptées pour l’isolation, l’agencement intérieur et les finitions, selon vos besoins et votre budget.',
	},
	{
		Icone: Layers,
		titre: 'Isolation et aménagement intérieur',
		description: 'Isolation des rampants, création de cloisons, plafonds et revêtements : nous coordonnons les différentes étapes pour transformer vos combles en un espace confortable, fonctionnel et agréable à vivre.',
	},
	{
		Icone: Sun,
		titre: 'Ouvertures, équipements et finitions',
		description: 'Installation de fenêtres de toit, adaptation des réseaux électriques, chauffage, ventilation et finitions intérieures : nous organisons les interventions nécessaires pour donner vie à votre nouvel espace.',
	},
];

const faqCombles = [
	{ question: "Peut-on aménager tous les combles ?", reponse: "Tous les combles ne sont pas nécessairement aménageables. La hauteur disponible, la configuration de la charpente et la présence d'un plancher adapté sont des éléments essentiels. MIPE Habitat intervient sur des combles déjà aménageables, pour les transformer en espaces de vie confortables et fonctionnels.", ouvert: true },
	{ question: "Faut-il isoler ses combles avant de les aménager ?", reponse: "Une bonne isolation est indispensable pour profiter de vos combles été comme hiver. L'isolation des rampants est généralement intégrée aux travaux d'aménagement, avant la réalisation des habillages et des finitions intérieures.", ouvert: false },
	{ question: "Quels travaux réalisez-vous pour aménager des combles ?", reponse: "Nous intervenons sur l'isolation des rampants, la création de cloisons, les plafonds, les habillages et les finitions intérieures. Selon votre projet, nous pouvons également coordonner l'installation de fenêtres de toit et les interventions complémentaires nécessaires à l'aménagement de votre nouvel espace.", ouvert: false },
	{ question: "Faut-il une autorisation pour aménager ses combles ?", reponse: "Cela dépend des travaux envisagés. Une déclaration préalable ou un permis de construire peut être nécessaire selon la surface créée, les modifications extérieures et les règles d'urbanisme applicables. Nous vous invitons à vérifier ces obligations auprès de votre mairie avant le démarrage des travaux.", ouvert: false },
	{ question: "Le déplacement et le devis sont-ils gratuits ?", reponse: "Oui, nos devis sont gratuits et sans engagement. Après un premier échange, un conseiller MIPE Habitat se déplace pour étudier votre projet, examiner la configuration de vos combles et vous proposer une solution d'aménagement adaptée à vos besoins et à votre budget.", ouvert: false },
];
---

<Layout title="Aménagement de combles : chambre, bureau, pièce de vie | MIPE Habitat" description="Transformez vos combles en pièce à vivre : étude de la charpente et de la hauteur, isolation, plaques de plâtre et finitions. MIPE Habitat, Oise et Île-de-France.">
	<main>
		<Navbar></Navbar>
		<div class="refonte">
		<FilAriane items={[{ label: 'Nos métiers', href: '/nos-metiers' }, { label: 'Aménagement des combles' }]} />

		<section class="containerImageDroite">
			<div class="containerParentImageDroite">
				<div class="textImageDroite">
					<p class="petitTitre">Aménagement des combles</p>
					<h1 class="titreImage">Transformez vos combles en un nouvel espace de vie</h1>
					<p class="descImage">Chambre, bureau, salle de jeux... Vos combles perdus peuvent devenir une pièce à vivre à part entière. MIPE Habitat vous accompagne dans l’aménagement complet de votre espace sous toiture.</p>
					<p class="check"><Check size={15} color="#8FE05C" />Gain de surface habitable sans agrandir votre maison</p>
					<p class="check"><Check size={15} color="#8FE05C" />Isolation, sol, cloisons et finitions</p>
					<p class="check"><Check size={15} color="#8FE05C" />Ouvertures pour la lumière naturelle</p>
				</div>
				<div class="imageDroite">
					<Image src={photoCombles} alt="Aménagement de combles en espace de vie" />
				</div>
			</div>
		</section>

		<section class="sectionInterventionsCombles reveal">
			<p class="petitTitre petitTitreCombles">Nos interventions</p>
			<h2 class="titreInterventionsCombles">De l’étude à la pièce finie</h2>
			<div class="grilleInterventionsCombles">
				{
					interventions.map(({ Icone, titre, description }) => (
						<div class="carteInterventionCombles reveal">
							<div class="iconeInterventionCombles"><Icone size={26} color="#ffffff" /></div>
							<p class="titreCarteCombles">{titre}</p>
							<p class="descCarteCombles">{description}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="sectionFaqCombles">
			<div class="faqComblesTexte">
				<p class="petitTitre">Questions fréquentes</p>
				<h2 class="titreFaqCombles">Vos questions sur l’aménagement des combles</h2>
			</div>
			<div class="faqComblesListe">
				{
					faqCombles.map(({ question, reponse, ouvert }) => (
						<details class="faqComblesItem" open={ouvert}>
							<summary class="questionFaqCombles">{question}</summary>
							<p class="reponseFaqCombles">{reponse}</p>
						</details>
					))
				}
			</div>
		</section>

		</div>
		<FaqSchema items={faqCombles} />
		<Footer></Footer>
	</main>
</Layout>
